---
import { SITE } from '../data/site';
interface Props { judul: string; path: string; ringkas?: string }
const { judul, path, ringkas = '' } = Astro.props;

const url = new URL(path, SITE.url).href;
const t = encodeURIComponent(judul);
const u = encodeURIComponent(url);
const r = encodeURIComponent(ringkas);

const target = [
  { n: 'WhatsApp', k: 'wa', h: `https://wa.me/?text=${t}%20${u}` },
  { n: 'X', k: 'x', h: `https://twitter.com/intent/tweet?text=${t}&url=${u}&via=xyverse_id` },
  { n: 'Facebook', k: 'fb', h: `https://www.facebook.com/sharer/sharer.php?u=${u}` },
  { n: 'LinkedIn', k: 'li', h: `https://www.linkedin.com/sharing/share-offsite/?url=${u}` },
  { n: 'Telegram', k: 'tg', h: `https://t.me/share/url?url=${u}&text=${t}` },
  { n: 'Reddit', k: 'rd', h: `https://reddit.com/submit?url=${u}&title=${t}` },
  { n: 'Email', k: 'em', h: `mailto:?subject=${t}&body=${r}%0A%0A${u}` },
];

const IK: Record<string, string> = {
  wa: '<path d="M21 11.5a8.4 8.4 0 0 1-12.6 7.3L3 20.5l1.8-5.3A8.4 8.4 0 1 1 21 11.5z"/>',
  x: '<path d="M3 3h4.2l5 6.7L17.6 3H21l-7.1 8.3L21.4 21h-4.2l-5.3-7.1L6 21H2.6l7.5-8.8z" fill="currentColor" stroke="none"/>',
  fb: '<path d="M14 8.5V7a1.5 1.5 0 0 1 1.5-1.5H17V2.5h-2.5A4.5 4.5 0 0 0 10 7v1.5H7.5V12H10v9.5h4V12h2.6l.4-3.5z" fill="currentColor" stroke="none"/>',
  li: '<rect x="2.5" y="2.5" width="19" height="19" rx="3.2"/><path d="M7 10.5V17M7 7.2v.1M11.2 17v-3.6a2.3 2.3 0 0 1 4.6 0V17M11.2 10.5V17"/>',
  tg: '<path d="M21.5 4.3 2.9 11.2c-1 .4-1 1.1-.2 1.4l4.7 1.5 1.8 5.4c.2.6.4.8 1 .8.4 0 .6-.2.9-.5l2.3-2.2 4.7 3.5c.9.5 1.5.2 1.7-.8l3.1-14.6c.3-1.2-.5-1.8-1.4-1.4z"/>',
  rd: '<circle cx="12" cy="12" r="9.2"/><circle cx="9" cy="12.4" r="1.1" fill="currentColor" stroke="none"/><circle cx="15" cy="12.4" r="1.1" fill="currentColor" stroke="none"/><path d="M9 16c1.8 1.2 4.2 1.2 6 0"/>',
  em: '<rect x="2" y="4.5" width="20" height="15" rx="2.2"/><path d="m2.6 6.4 9.4 6.2 9.4-6.2"/>',
};
---

<aside class="bagikan" aria-label="Bagikan halaman ini">
  <span class="lbl">Bagikan</span>
  <div class="row">
    {target.map((s) => (
      <a href={s.h} target="_blank" rel="noopener noreferrer" aria-label={`Bagikan ke ${s.n}`} title={s.n} data-k={s.k}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={IK[s.k]} />
      </a>
    ))}
    <button id="salin" data-url={url} aria-label="Salin tautan" title="Salin tautan">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <rect x="9" y="9" width="12" height="12" rx="2.2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/>
      </svg>
    </button>
    <button id="native" hidden aria-label="Bagikan lewat perangkat" title="Bagikan lainnya"
      data-judul={judul} data-url={url} data-teks={ringkas}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="18" cy="5" r="2.6"/><circle cx="6" cy="12" r="2.6"/><circle cx="18" cy="19" r="2.6"/>
        <path d="m8.3 10.8 7.4-4.3M8.3 13.2l7.4 4.3"/>
      </svg>
    </button>
  </div>
</aside>

<style>
.bagikan{display:flex;align-items:center;gap:14px;flex-wrap:wrap;padding:16px 0}
.lbl{font-size:11.5px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--txt-2)}
.row{display:flex;gap:7px;flex-wrap:wrap}
.row a,.row button{
  width:38px;height:38px;border-radius:10px;display:grid;place-items:center;cursor:pointer;
  border:1px solid var(--line);background:var(--card);color:var(--txt-2);
  transition:.22s var(--ease);
}
.row a:hover,.row button:hover{transform:translateY(-3px);color:#fff;border-color:transparent}
.row a[data-k='wa']:hover{background:#25d366}
.row a[data-k='x']:hover{background:#000}
.row a[data-k='fb']:hover{background:#1877f2}
.row a[data-k='li']:hover{background:#0a66c2}
.row a[data-k='tg']:hover{background:#26a5e4}
.row a[data-k='rd']:hover{background:#ff4500}
.row a[data-k='em']:hover{background:var(--pur)}
.row button:hover{background:var(--pur)}
.row svg{width:16px;height:16px}
.row button.ok{background:#10b981;border-color:#10b981;color:#fff}
</style>

<script>
  const s = document.getElementById('salin') as HTMLButtonElement | null;
  s?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(s.dataset.url || location.href);
      s.classList.add('ok');
      setTimeout(() => s.classList.remove('ok'), 1600);
    } catch {}
  });

  const n = document.getElementById('native') as HTMLButtonElement | null;
  if (n && typeof navigator !== 'undefined' && 'share' in navigator) {
    n.hidden = false;
    n.addEventListener('click', () => {
      navigator.share({ title: n.dataset.judul, text: n.dataset.teks, url: n.dataset.url }).catch(() => {});
    });
  }
</script>
