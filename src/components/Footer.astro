---
import { SITE, SOSMED, APLIKASI } from '../data/site';
import { langDariPath, rute } from '../i18n/config';
import { pakaiT } from '../i18n/ui';
import { sumberNav, legalNav, APLIKASI_TEKS, DESC_SITUS } from '../i18n/data';
import SosmedIkon from './SosmedIkon.astro';

const year = new Date().getFullYear();
const lang = langDariPath(Astro.url.pathname);
const t = pakaiT(lang);
const r = (p = '') => rute(lang, p);
const SUMBER = sumberNav(lang);
const LEGAL = legalNav(lang);

const kolom = [
  {
    h: t('foot.layanan'),
    l: [
      [t('sheet.sewaCloudPc'), r('cloud-pc')],
      [t('sheet.produksiApps'), r() + '#layanan'],
      [t('sheet.softwareCustom'), r() + '#layanan'],
      [t('sheet.tools'), r() + '#layanan'],
      [t('nav.harga'), r('harga')],
    ] as [string, string][],
  },
  {
    h: t('foot.aplikasi'),
    l: [
      ...APLIKASI.map((a) => [a.nama, r(`aplikasi/${a.slug}`)] as [string, string]),
      [t('sheet.semuaAplikasi'), r('aplikasi')],
      [t('foot.unduh'), r('aplikasi') + '#unduh'],
    ] as [string, string][],
  },
  {
    h: t('foot.jelajahi'),
    l: [
      [t('sheet.proyek'), r('proyek')],
      [t('foot.blog'), r('blog')],
      [t('foot.berita'), r('berita')],
      [t('foot.cari'), r('cari')],
      [t('nav.tentang'), r('tentang')],
      [t('sheet.tim'), r('tentang') + '#tim'],
    ] as [string, string][],
  },
  {
    h: t('foot.sumber'),
    l: SUMBER.slice(0, 5).map((x) => [x.t, r(x.slug)] as [string, string]),
  },
  {
    h: t('foot.komunitas'),
    l: [
      ...SUMBER.slice(5).map((x) => [x.t, r(x.slug)] as [string, string]),
      [t('um.hubungiKami'), r('kontak')],
    ] as [string, string][],
  },
  {
    h: t('foot.legal'),
    l: LEGAL.slice(0, 6).map((x) => [x.t, r(`legal/${x.slug}`)] as [string, string]),
  },
];
---

<footer>
  <svg class="tepi-svg" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <linearGradient id="fbibir" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="var(--pur)" stop-opacity="0" />
        <stop offset="26%" stop-color="var(--pur)" stop-opacity=".45" />
        <stop offset="50%" stop-color="var(--pur-l)" stop-opacity=".7" />
        <stop offset="74%" stop-color="var(--pur)" stop-opacity=".45" />
        <stop offset="100%" stop-color="var(--pur)" stop-opacity="0" />
      </linearGradient>
    </defs>

    <!-- lapisan belakang: lengkung kedua, memberi kedalaman -->
    <path class="tl-blkg" fill="var(--bg-2)" opacity=".45"
      d="M0,58 C210,10 330,86 540,56 C760,24 880,92 1080,62 C1240,38 1350,74 1440,46 L1440,121 L0,121 Z" />

    <!-- lengkung utama: menyatu dengan badan footer di bawahnya -->
    <path class="tl-isi" fill="var(--bg-2)"
      d="M0,40 C180,86 340,8 560,46 C770,82 900,18 1090,50 C1250,76 1360,34 1440,64 L1440,121 L0,121 Z" />

    <!-- bibir tipis mengikuti lengkung utama -->
    <path class="tl-bibir" fill="none" stroke="url(#fbibir)" stroke-width="1.6"
      d="M0,40 C180,86 340,8 560,46 C770,82 900,18 1090,50 C1250,76 1360,34 1440,64" />
  </svg>

  <div class="wrap">
    <div class="top">
      <div class="bcol">
        <a href={r()} class="brand">
          <img src="/brand/mark-flat-purple.webp" alt="" width="38" height="38" />
          <span class="dsp">XYVERSE</span>
        </a>
        <p class="tag">{DESC_SITUS[lang]}</p>

        <a href={`mailto:${SITE.email}`} class="mail">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/></svg>
          {SITE.email}
        </a>

        <address>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <span>
            {SITE.alamat.jalan}<br />
            {SITE.alamat.kota}, {SITE.alamat.provinsi} {SITE.alamat.pos}<br />
            {SITE.alamat.negara}
          </span>
        </address>

        <div class="sos">
          {SOSMED.map((s) => (
            <a href={s.url} target="_blank" rel="noopener noreferrer me" aria-label={s.nama} title={s.nama}>
              <SosmedIkon nama={s.ikon} />
            </a>
          ))}
        </div>
      </div>

      {kolom.map((c) => (
        <nav class="col" aria-label={c.h}>
          <h4>{c.h}</h4>
          {c.l.map(([t, h]) => <a href={h}>{t}</a>)}
        </nav>
      ))}
    </div>

    <div class="bot">
      <span>© {year} {SITE.nama}. {t('foot.hak')}</span>
      <div class="botlinks">
        <a href={r('legal')}>{t('foot.pusatLegal')}</a>
        <a href={r('legal/kebijakan-privasi')}>{t('foot.privasi')}</a>
        <a href={r('legal/syarat-layanan')}>{t('foot.syarat')}</a>
        <a href="/sitemap-index.xml">{t('foot.sitemap')}</a>
      </div>
    </div>
  </div>
</footer>

<style>
/* ===== FOOTER: LATARNYA SENDIRI YANG DIBENTUK SOBEKAN ===== */
footer{
  position:relative;z-index:6;border-top:0;
  background:var(--bg-2);            /* satu warna dengan lengkung di atasnya */
  margin-top:-56px;                  /* naik menimpa konten di atasnya */
  padding:52px 0 30px;
}
@media(max-width:760px){
  footer{margin-top:-30px;padding-top:36px}
}

/* lengkung diletakkan TEPAT di atas kotak footer, lalu ditumpuk 1px -> tanpa celah */
.tepi-svg{
  position:absolute;left:0;right:0;bottom:100%;
  width:100%;height:120px;margin-bottom:-1px;
  display:block;pointer-events:none;
}
@media(max-width:760px){.tepi-svg{height:78px}}
.tl-blkg{display:none}
@media(min-width:1001px){.tl-blkg{display:block}}

footer::before{
  content:'';position:absolute;inset:0;pointer-events:none;z-index:1;
  background:radial-gradient(ellipse 52% 46% at 50% 22%,var(--glow),transparent 62%);
  opacity:.55;
}

/* isi footer HARUS di atas ketiga lapisan latar */
footer > .wrap{position:relative;z-index:3}

.top{display:grid;grid-template-columns:1.6fr repeat(6,1fr);gap:30px}
@media(max-width:1240px){.top{grid-template-columns:1.4fr repeat(3,1fr);gap:30px}}
@media(max-width:1000px){.top{grid-template-columns:1fr 1fr 1fr;gap:32px}}
@media(max-width:760px){.top{grid-template-columns:1fr 1fr}}
@media(max-width:480px){.top{grid-template-columns:1fr}}

.brand{display:flex;align-items:center;gap:10px;font-weight:700;letter-spacing:.16em;margin-bottom:16px;font-size:15px}
.brand img{transition:transform .3s var(--ease)}
.brand:hover img{transform:none}
.tag{color:var(--txt-2);font-size:14.5px;max-width:36ch;margin-bottom:18px}

.mail{display:inline-flex;align-items:center;gap:9px;font-size:14.5px;font-weight:600;color:var(--brand);transition:.2s}
.mail:hover{opacity:.75}
.mail svg{width:17px;height:17px}

address{display:flex;gap:9px;margin-top:14px;font-style:normal;font-size:13.5px;color:var(--txt-2);line-height:1.6;max-width:34ch}
address svg{width:16px;height:16px;flex:none;margin-top:3px;color:var(--brand)}

.sos{display:flex;gap:8px;flex-wrap:wrap;margin-top:22px}
.sos a{
  width:34px;height:34px;border-radius:var(--rb);display:grid;place-items:center;
  border:1px solid var(--line-s);background:var(--card);color:var(--txt-2);
  transition:background .14s ease,color .14s ease,border-color .14s ease;
}
.sos a:hover{color:#fff;background:var(--pur);border-color:var(--pur)}
.sos :global(svg){width:16px;height:16px}

.col h4{font-size:12.5px;letter-spacing:.13em;text-transform:uppercase;margin-bottom:15px;color:var(--txt);font-weight:600}
.col a{display:block;color:var(--txt-2);font-size:14.5px;padding:5px 0;transition:.2s;width:fit-content}
.col a:hover{color:var(--brand)}

.bot{
  display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;align-items:center;
  margin-top:52px;padding-top:24px;border-top:1px solid var(--line);
  color:var(--txt-2);font-size:13px;
}
.botlinks{display:flex;gap:18px;flex-wrap:wrap}
.botlinks a:hover{color:var(--brand)}
</style>
