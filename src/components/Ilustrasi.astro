---
/**
 * Ilustrasi WebP responsif: browser memilih 480/800/lebar asli sesuai viewport + DPR.
 * Dimensi eksplisit menyediakan ruang sebelum gambar dimuat.
 */
interface Props {
  nama: string;
  alt?: string;
  w?: number;
  h?: number;
  prioritas?: boolean;
  k?: string;
  sizes?: string;
}
const { nama, alt = '', w = 1376, h = 768, prioritas = false, k = '', sizes = '(max-width:480px) calc(100vw - 48px), (max-width:760px) 92vw, 620px' } = Astro.props;
---
<img
  class={`ilus ${k}`}
  src={`/ilus/${nama}.webp`}
  srcset={`/ilus/${nama}-xs.webp 480w, /ilus/${nama}-sm.webp 800w, /ilus/${nama}.webp ${nama === 'kosong' ? 1024 : 1376}w`}
  sizes={sizes}
  alt={alt}
  width={w} height={h}
  loading={prioritas ? 'eager' : 'lazy'}
  decoding="async"
  fetchpriority={prioritas ? 'high' : 'auto'}
/>

<style>
.ilus{
  display:block;width:100%;height:auto;border-radius:12px;
  border:1px solid var(--line);background:var(--bg-2);
}
</style>
