---
/**
 * Ilustrasi WebP responsif. Selalu memuat varian -sm pada layar kecil,
 * ukuran ditetapkan agar tidak ada pergeseran tata letak (CLS = 0).
 */
interface Props {
  nama: string;
  alt?: string;
  w?: number;
  h?: number;
  prioritas?: boolean;
  k?: string;
}
const { nama, alt = '', w = 1376, h = 768, prioritas = false, k = '' } = Astro.props;
---
<img
  class={`ilus ${k}`}
  src={`/ilus/${nama}.webp`}
  srcset={`/ilus/${nama}-sm.webp 800w, /ilus/${nama}.webp 1376w`}
  sizes="(max-width:760px) 92vw, 620px"
  alt={alt}
  width={w} height={h}
  loading={prioritas ? 'eager' : 'lazy'}
  decoding="async"
  fetchpriority={prioritas ? 'high' : 'auto'}
/>

<style>
.ilus{
  display:block;width:100%;height:auto;border-radius:12px;
  border:1px solid var(--line);background:var(--bg-2);
}
</style>
