---
const links = [
  { h: '/cloud-pc', t: 'Cloud PC' },
  { h: '/aplikasi/', t: 'Aplikasi' },
  { h: '/harga', t: 'Harga' },
  { h: '/proyek/', t: 'Proyek' },
  { h: '/blog/', t: 'Blog' },
  { h: '/berita/', t: 'Berita' },
  { h: '/tentang', t: 'Tentang' },
];
const path = Astro.url.pathname;
---
<header id="nav">
  <div class="wrap bar">
    <a href="/" class="brand" aria-label="Xyverse beranda">
      <img src="/brand/mark-flat-purple.webp" alt="" width="40" height="40" />
      <span class="dsp">XYVERSE</span>
    </a>

    <nav class="links" aria-label="Utama">
      {links.map((l) => (
        <a href={l.h} class={l.h.length > 2 && path.startsWith(l.h.replace(/\/$/, '')) ? 'act' : ''}>{l.t}</a>
      ))}
    </nav>

    <div class="right">
      <button id="theme" class="icon-btn" aria-label="Ganti tema">
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
        </svg>
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
        </svg>
      </button>
      <a href="/kontak/" class="btn btn-p cta">Mulai Proyek</a>
      <button id="burger" class="icon-btn only-m" aria-label="Buka menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div id="mob">
    <div class="wrap">
      {links.map((l) => <a href={l.h}>{l.t}</a>)}
      <a href="/kontak/" class="btn btn-p" style="margin-top:10px">Mulai Proyek</a>
    </div>
  </div>
</header>

<style>
header{
  position:sticky;top:0;z-index:80;
  backdrop-filter:blur(18px) saturate(1.6);
  background:color-mix(in srgb,var(--bg) 78%,transparent);
  border-bottom:1px solid transparent;transition:border-color .3s,box-shadow .3s;
}
header.scrolled{border-bottom-color:var(--line);box-shadow:0 6px 22px -14px rgba(0,0,0,.4)}
.bar{display:flex;align-items:center;gap:24px;height:72px}
.brand{display:flex;align-items:center;gap:11px;font-size:16px;font-weight:700;letter-spacing:.16em;flex:none}
.brand img{transition:transform .3s var(--ease)}
.brand:hover img{transform:rotate(-8deg) scale(1.06)}
.links{display:flex;gap:6px;margin-left:8px}
.links a{
  font-size:14.5px;font-weight:500;color:var(--txt-2);padding:8px 14px;border-radius:9px;
  transition:color .2s,background .2s;
}
.links a:hover{color:var(--txt);background:var(--card)}
.links a.act{color:var(--brand);background:color-mix(in srgb,var(--pur) 10%,transparent)}
.right{display:flex;align-items:center;gap:10px;margin-left:auto}
.icon-btn{
  width:40px;height:40px;display:grid;place-items:center;border-radius:11px;cursor:pointer;
  background:var(--card);border:1px solid var(--line);color:var(--txt-2);transition:.22s var(--ease);
}
.icon-btn:hover{color:var(--brand);border-color:var(--line-s)}
.icon-btn svg{width:18px;height:18px}
html[data-theme='dark'] .sun{display:block}
html[data-theme='dark'] .moon{display:none}
html[data-theme='light'] .sun{display:none}
html[data-theme='light'] .moon{display:block}
.cta{padding:10px 20px;font-size:14px}
#burger{display:none;flex-direction:column;gap:4.5px}
#burger span{width:17px;height:2px;background:currentColor;border-radius:2px;transition:.25s var(--ease)}
#burger[aria-expanded='true'] span:nth-child(1){transform:translateY(6.5px) rotate(45deg)}
#burger[aria-expanded='true'] span:nth-child(2){opacity:0}
#burger[aria-expanded='true'] span:nth-child(3){transform:translateY(-6.5px) rotate(-45deg)}
#mob{display:none;border-top:1px solid var(--line);background:var(--bg-2);padding:16px 0 22px}
#mob.open{display:block}
#mob .wrap{display:flex;flex-direction:column;gap:2px}
#mob a:not(.btn){padding:13px 4px;color:var(--txt-2);font-weight:500;border-bottom:1px solid var(--line)}
@media(max-width:1000px){.links,.cta{display:none}#burger{display:flex}}
@media(min-width:901px){.only-m{display:none}}
</style>

<script>
  const nav = document.getElementById('nav');
  const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const b = document.getElementById('burger');
  const m = document.getElementById('mob');
  b?.addEventListener('click', () => {
    const open = m?.classList.toggle('open');
    b.setAttribute('aria-expanded', String(!!open));
  });
  m?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      m.classList.remove('open');
      b?.setAttribute('aria-expanded', 'false');
    })
  );

  document.getElementById('theme')?.addEventListener('click', () => {
    const el = document.documentElement;
    const next = el.dataset.theme === 'dark' ? 'light' : 'dark';
    el.dataset.theme = next;
    localStorage.setItem('xy-theme', next);
  });
</script>
