---
import { APLIKASI } from '../data/site';
import { BAHASA, SEMUA_LANG, langDariPath, tanpaPrefiks, rute } from '../i18n/config';
import { pakaiT } from '../i18n/ui';
import { APLIKASI_TEKS } from '../i18n/data';

const path = Astro.url.pathname;
const lang = langDariPath(path);
const t = pakaiT(lang);
const r = (p = '') => rute(lang, p);
const jalurMurni = tanpaPrefiks(path);
const teksApp = APLIKASI_TEKS[lang];

// Menu bertingkat: item dengan `panel` membuka sheet, tanpa `panel` = tautan biasa
const menu = [
  {
    t: t('nav.produk'),
    cocok: ['cloud-pc', 'aplikasi'],
    panel: {
      kolom: [
        {
          h: t('sheet.cloudpc'),
          item: [
            { t: t('sheet.sewaCloudPc'), d: t('sheet.sewaCloudPc.d'), h: r('cloud-pc'), ik: 'server' },
            { t: t('nav.harga'), d: t('sheet.harga.d'), h: r('harga'), ik: 'tag' },
          ],
        },
        {
          h: t('sheet.aplikasi'),
          item: [
            { t: 'XyDesk', d: t('sheet.xydesk.d'), h: r('aplikasi/xydesk'), ik: 'monitor' },
            { t: 'XyCloudStore', d: t('sheet.xycloudstore.d'), h: r('aplikasi/xycloudstore'), ik: 'app' },
            { t: t('sheet.semuaAplikasi'), d: t('sheet.semuaAplikasi.d'), h: r('aplikasi'), ik: 'grid' },
          ],
        },
      ],
      kaki: { t: t('sheet.kaki.bantuan'), l: t('sheet.kaki.dukungan'), h: r('kontak') },
    },
  },
  {
    t: t('nav.solusi'),
    cocok: ['proyek'],
    panel: {
      kolom: [
        {
          h: t('sheet.layanan'),
          item: [
            { t: t('sheet.produksiApps'), d: t('sheet.produksiApps.d'), h: r() + '#layanan', ik: 'code' },
            { t: t('sheet.softwareCustom'), d: t('sheet.softwareCustom.d'), h: r() + '#layanan', ik: 'spark' },
            { t: t('sheet.tools'), d: t('sheet.tools.d'), h: r() + '#layanan', ik: 'bolt' },
          ],
        },
        {
          h: t('sheet.buktiKerja'),
          item: [
            { t: t('sheet.proyek'), d: t('sheet.proyek.d'), h: r('proyek'), ik: 'folder' },
            { t: t('sheet.cloudpc'), d: t('sheet.sewaCloudPc.d'), h: r('cloud-pc'), ik: 'server' },
            { t: t('nav.harga'), d: t('sheet.harga.d'), h: r('harga'), ik: 'tag' },
          ],
        },
      ],
      kaki: { t: t('sheet.kaki.ngobrol'), l: t('sheet.kaki.hubungi'), h: r('kontak') },
    },
  },
  { t: t('nav.harga'), h: r('harga') },
  {
    t: t('nav.sumber'),
    cocok: ['blog', 'berita', 'legal', 'panduan', 'pelajari', 'changelog', 'faq', 'status', 'cari'],
    panel: {
      kolom: [
        {
          h: t('sheet.belajar'),
          item: [
            { t: t('foot.panduan'), d: t('sheet.panduan.d'), h: r('panduan'), ik: 'compass' },
            { t: t('foot.pelajari'), d: t('sheet.pelajari.d'), h: r('pelajari'), ik: 'cap' },
            { t: 'FAQ', d: t('sheet.faq.d'), h: r('faq'), ik: 'help' },
            { t: t('foot.blog'), d: t('sheet.blog.d'), h: r('blog'), ik: 'book' },
            { t: t('sheet.cari'), d: t('sheet.cari.d'), h: r('cari'), ik: 'search' },
          ],
        },
        {
          h: t('sheet.produkLayanan'),
          item: [
            { t: t('foot.changelog'), d: t('sheet.changelog.d'), h: r('changelog'), ik: 'clock' },
            { t: t('foot.status'), d: t('sheet.status.d'), h: r('status'), ik: 'gauge' },
            { t: t('foot.berita'), d: t('sheet.berita.d'), h: r('berita'), ik: 'megaphone' },
            { t: t('foot.pusatLegal'), d: t('sheet.legal.d'), h: r('legal'), ik: 'doc' },
          ],
        },
        {
          h: t('sheet.terlibat'),
          item: [
            { t: t('foot.komunitas'), d: t('sheet.komunitas.d'), h: r('komunitas'), ik: 'users' },
            { t: t('foot.kontribusi'), d: t('sheet.kontribusi.d'), h: r('kontribusi'), ik: 'heart' },
            { t: t('foot.kolaborasi'), d: t('sheet.kolaborasi.d'), h: r('kolaborasi'), ik: 'handshake' },
            { t: t('foot.sponsor'), d: t('sheet.sponsor.d'), h: r('sponsor'), ik: 'star' },
          ],
        },
      ],
      kaki: { t: t('sheet.kaki.bantuan'), l: t('sheet.kaki.dukungan'), h: r('kontak') },
    },
  },
  {
    t: t('nav.tentang'),
    cocok: ['tentang', 'karier'],
    panel: {
      kolom: [
        {
          h: t('sheet.perusahaan'),
          item: [
            { t: t('sheet.tentangXy'), d: t('sheet.tentangXy.d'), h: r('tentang'), ik: 'spark' },
            { t: t('sheet.tim'), d: t('sheet.tim.d'), h: r('tentang') + '#tim', ik: 'users' },
            { t: t('foot.karier'), d: t('sheet.karier.d'), h: r('karier'), ik: 'briefcase' },
          ],
        },
        {
          h: t('sheet.kepercayaan'),
          item: [
            { t: t('sheet.proyek'), d: t('sheet.proyek.d'), h: r('proyek'), ik: 'folder' },
            { t: t('foot.keamanan'), d: t('sheet.keamanan.d'), h: r('legal/keamanan'), ik: 'shield' },
            { t: t('foot.sla'), d: t('sheet.sla.d'), h: r('legal/sla'), ik: 'gauge' },
          ],
        },
      ],
      kaki: { t: t('sheet.kaki.ngobrol'), l: t('sheet.kaki.hubungi'), h: r('kontak') },
    },
  },
];

const IK: Record<string, string> = {
  search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6"/>',
  server: '<rect x="3" y="4" width="18" height="7" rx="2"/><rect x="3" y="13" width="18" height="7" rx="2"/><path d="M7 7.5h.01M7 16.5h.01"/>',
  tag: '<path d="M11.6 3H4v7.6l9.4 9.4 7.6-7.6z"/><circle cx="7.8" cy="7.2" r="1.3"/>',
  monitor: '<rect x="2.5" y="3.5" width="19" height="13" rx="2"/><path d="M8.5 20.5h7M12 16.5v4"/>',
  grid: '<rect x="3" y="3" width="7.5" height="7.5" rx="1.6"/><rect x="13.5" y="3" width="7.5" height="7.5" rx="1.6"/><rect x="3" y="13.5" width="7.5" height="7.5" rx="1.6"/><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1.6"/>',
  app: '<rect x="6" y="2.5" width="12" height="19" rx="2.5"/><path d="M11 18.5h2"/>',
  code: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
  bolt: '<path d="M13 2 4.5 13.5H11l-1 8.5 8.5-11.5H12z"/>',
  folder: '<path d="M3 7.5a2 2 0 0 1 2-2h4l2 2.5h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
  spark: '<path d="M12 2.5 14 9l6.5 2-6.5 2-2 6.5-2-6.5L3.5 11 10 9z"/>',
  users: '<circle cx="9" cy="8" r="3.4"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0M16.5 5.2a3.4 3.4 0 0 1 0 6.6M18 20a6.4 6.4 0 0 0-2.5-5.1"/>',
  book: '<path d="M4 4.5A2 2 0 0 1 6 2.5h13v17H6a2 2 0 0 0-2 2z"/><path d="M4 19.5h15"/>',
  megaphone: '<path d="M3 11v2a1.5 1.5 0 0 0 1.5 1.5H7l7 4.5V6.5L7 11H4.5A1.5 1.5 0 0 0 3 11z"/><path d="M17.5 9.5a3.5 3.5 0 0 1 0 5"/>',
  rss: '<path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1.6" fill="currentColor" stroke="none"/>',
  doc: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h5"/>',
  gauge: '<path d="M4 17a9 9 0 1 1 16 0"/><path d="m12 13 4-3.5"/><circle cx="12" cy="17" r="1.5"/>',
  shield: '<path d="M12 2.5 4.5 5.8v5.4c0 4.7 3.2 9 7.5 10.3 4.3-1.3 7.5-5.6 7.5-10.3V5.8z"/><path d="m9 12 2 2 4-4"/>',
  compass: '<circle cx="12" cy="12" r="9.2"/><path d="m15.6 8.4-2 5.2-5.2 2 2-5.2z"/>',
  cap: '<path d="M12 3 2 8l10 5 10-5z"/><path d="M6 10.5V16c0 1.7 2.7 3 6 3s6-1.3 6-3v-5.5"/>',
  help: '<circle cx="12" cy="12" r="9.2"/><path d="M9.4 9.4a2.7 2.7 0 0 1 5.2.9c0 1.8-2.6 2.2-2.6 3.9M12 17.4v.4"/>',
  clock: '<circle cx="12" cy="12" r="9.2"/><path d="M12 6.8V12l3.4 2"/>',
  heart: '<path d="M12 20.5 4.3 13a4.7 4.7 0 0 1 6.6-6.7l1.1 1 1.1-1A4.7 4.7 0 0 1 19.7 13z"/>',
  handshake: '<path d="m11 7-3 3 3.5 3.5L14 11l4 4-4.5 4.5L3 9l3.5-3.5H10zM14 11l3-3h4"/>',
  star: '<path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1 6.2-5.5-2.9L6.5 20l1-6.2L3 9.6l6.2-.9z"/>',
  briefcase: '<rect x="2.5" y="7" width="19" height="13" rx="2.2"/><path d="M8.5 7V5.2a1.7 1.7 0 0 1 1.7-1.7h3.6a1.7 1.7 0 0 1 1.7 1.7V7M2.5 12.5h19"/>',
};

const aktif = (m: any) =>
  m.h
    ? path === m.h || path.startsWith(m.h.replace(/\/$/, '') + '/')
    : (m.cocok || []).some((c: string) => jalurMurni === c || jalurMurni.startsWith(c + '/'));
---

<header id="nav">
  <div class="wrap bar">
    <a href={r()} class="brand" aria-label={t('nav.arBeranda')}>
      <img src="/brand/mark-flat-purple.webp" alt="" width="52" height="52" />
      <span class="dsp">XYVERSE</span>
    </a>

    <nav class="links" aria-label={t('nav.utama')}>
      {menu.map((m, i) =>
        m.panel ? (
          <div class="mi">
            <button
              class={`trig ${aktif(m) ? 'act' : ''}`}
              data-sheet={i}
              aria-expanded="false"
              aria-controls={`sheet-${i}`}
            >
              {m.t}
              <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
            </button>
          </div>
        ) : (
          <a href={m.h} class={aktif(m) ? 'act' : ''}>{m.t}</a>
        )
      )}
    </nav>

    <div class="right">
      <!-- PEMILIH BAHASA -->
      <div class="lang">
        <button id="langbtn" class="icon-btn lb" aria-expanded="false" aria-label={t('nav.gantiBahasa')} title={t('nav.gantiBahasa')}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9.2"/><path d="M2.8 12h18.4M12 2.8a15 15 0 0 1 0 18.4 15 15 0 0 1 0-18.4"/></svg>
          <span class="lkode">{BAHASA[lang].pendek}</span>
        </button>
        <div id="langmenu" class="lmenu" hidden>
          {SEMUA_LANG.map((l) => (
            <a
              href={`/${l}/${jalurMurni}${jalurMurni ? '/' : ''}`}
              class={l === lang ? 'on' : ''}
              hreflang={BAHASA[l].htmlLang}
              data-setlang={l}
            >
              <span class="lb-f">{BAHASA[l].bendera}</span>
              <span>{BAHASA[l].label}</span>
              {l === lang && (
                <svg class="lb-c" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              )}
            </a>
          ))}
        </div>
      </div>

      <button id="theme" class="icon-btn" aria-label={t('nav.gantiTema')} title={t('nav.gantiTema')}>
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.4M12 19.1v2.4M4.2 4.2l1.7 1.7M18.1 18.1l1.7 1.7M2.5 12h2.4M19.1 12h2.4M4.2 19.8l1.7-1.7M18.1 5.9l1.7-1.7"/></svg>
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 14.3A8.8 8.8 0 1 1 9.7 3.5a7 7 0 0 0 10.8 10.8z"/></svg>
      </button>

      <a href={r('kontak')} class="btn btn-p cta">{t('nav.mulai')}</a>

      <button id="burger" class="icon-btn only-m" aria-expanded="false" aria-label={t('nav.bukaMenu')}>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <!-- ===== SHEET DESKTOP ===== -->
  {menu.map((m, i) =>
    m.panel ? (
      <div class="sheet" id={`sheet-${i}`} data-panel={i} hidden>
        <div class="wrap sgrid">
          {m.panel.kolom.map((k) => (
            <div class="scol">
              <h3>{k.h}</h3>
              {k.item.map((it) => (
                <a href={it.h} class="sit">
                  <span class="sik">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={IK[it.ik]} />
                  </span>
                  <span class="stx">
                    <strong>{it.t}</strong>
                    <small>{it.d}</small>
                  </span>
                </a>
              ))}
            </div>
          ))}
          <div class="skaki">
            <p>{m.panel.kaki.t}</p>
            <a href={m.panel.kaki.h} class="btn btn-g btn-sm">{m.panel.kaki.l}</a>
          </div>
        </div>
      </div>
    ) : null
  )}

  <!-- ===== MENU MOBILE ===== -->
  <div id="mob">
    <div class="wrap">
      {menu.map((m) =>
        m.panel ? (
          <details class="mgrp">
            <summary>
              {m.t}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <div class="mbody">
              {m.panel.kolom.map((k) => (
                <>
                  <h4>{k.h}</h4>
                  {k.item.map((it) => <a href={it.h}>{it.t}</a>)}
                </>
              ))}
            </div>
          </details>
        ) : (
          <a href={m.h} class="mlink">{m.t}</a>
        )
      )}

      <div class="mlang">
        <h4>{t('nav.gantiBahasa')}</h4>
        <div class="mlrow">
          {SEMUA_LANG.map((l) => (
            <a
              href={`/${l}/${jalurMurni}${jalurMurni ? '/' : ''}`}
              class={l === lang ? 'on' : ''}
              hreflang={BAHASA[l].htmlLang}
              data-setlang={l}
            >{BAHASA[l].bendera} {BAHASA[l].label}</a>
          ))}
        </div>
      </div>

      <a href={r('kontak')} class="btn btn-p" style="margin-top:14px">{t('nav.mulai')}</a>
    </div>
  </div>

  <div id="tabir" hidden></div>
</header>

<style>
header{
  position:sticky;top:0;z-index:80;
  backdrop-filter:blur(18px) saturate(1.6);
  background:color-mix(in srgb,var(--bg) 82%,transparent);
  border-bottom:1px solid transparent;transition:border-color .3s,box-shadow .3s;
}
header.scrolled{border-bottom-color:var(--line);box-shadow:0 1px 3px rgba(0,0,0,.14)}
header.buka{background:var(--bg);border-bottom-color:var(--line)}
.bar{display:flex;align-items:center;gap:22px;height:84px}

/* ---- LOGO LEBIH BESAR ---- */
.brand{display:flex;align-items:center;gap:13px;font-size:19px;font-weight:700;letter-spacing:.17em;flex:none}
.brand img{width:52px;height:52px;transition:transform .32s cubic-bezier(.34,1.56,.64,1)}
.brand:hover img{transform:scale(1.07)}
@media(max-width:1000px){
  .bar{height:70px}
  .brand{font-size:16px;gap:10px}
  .brand img{width:42px;height:42px}
}

/* ---- LINK & PEMICU ---- */
.links{display:flex;gap:2px;margin-left:10px}
.links a,.trig{
  position:relative;
  display:inline-flex;align-items:center;gap:5px;
  font-size:14.5px;font-weight:500;color:var(--txt-2);
  padding:8px 13px;border-radius:var(--rb);
  background:none;border:0;cursor:pointer;font-family:inherit;
  transition:color .15s ease,background .15s ease;
}
/* garis bawah tumbuh dari tengah */
.links a::after,.trig::after{
  content:'';position:absolute;left:50%;right:50%;bottom:3px;height:2px;
  background:var(--pur);border-radius:2px;opacity:0;
  transition:left .24s var(--ease),right .24s var(--ease),opacity .24s var(--ease);
}
.links a:hover::after,.trig:hover::after,
.links a.act::after,.trig.act::after,
.trig[aria-expanded='true']::after{left:13px;right:13px;opacity:1}
.links a:hover,.trig:hover{color:var(--txt);background:var(--surface)}
.links a.act,.trig.act{color:var(--brand)}
.trig[aria-expanded='true']{color:var(--txt);background:var(--surface)}
.chev{width:14px;height:14px;transition:transform .3s cubic-bezier(.34,1.56,.64,1);opacity:.75}
.trig[aria-expanded='true'] .chev{transform:rotate(180deg)}

.right{display:flex;align-items:center;gap:10px;margin-left:auto}
.icon-btn{
  width:36px;height:36px;display:grid;place-items:center;border-radius:var(--rb);cursor:pointer;
  background:var(--card);border:1px solid var(--line-s);color:var(--txt-2);
  transition:background .14s ease,color .14s ease,border-color .14s ease;
}
.icon-btn:hover{background:var(--surface);color:var(--txt);border-color:var(--txt-2)}
.icon-btn svg{width:18px;height:18px;transition:transform .32s cubic-bezier(.34,1.56,.64,1)}
.icon-btn:hover svg{transform:rotate(18deg)}
html[data-theme='dark'] .sun{display:block}
html[data-theme='dark'] .moon{display:none}
html[data-theme='light'] .sun{display:none}
html[data-theme='light'] .moon{display:block}
.cta{padding:9px 17px;font-size:14px}

/* ---- PEMILIH BAHASA ---- */
.lang{position:relative}
.lb{width:auto;gap:6px;padding:0 10px}
.lkode{font-size:12.5px;font-weight:700;letter-spacing:.04em}
.lb svg{width:16px;height:16px}
.lb[aria-expanded='true']{background:var(--surface);color:var(--txt);border-color:var(--txt-2)}
.lmenu{
  position:absolute;top:calc(100% + 8px);right:0;min-width:178px;z-index:90;
  background:var(--bg);border:1px solid var(--line-s);border-radius:9px;padding:5px;
  box-shadow:0 12px 28px -12px rgba(0,0,0,.45);
  animation:turun .2s cubic-bezier(.16,1,.3,1);transform-origin:top right;
}
.lmenu a{
  display:flex;align-items:center;gap:9px;padding:9px 11px;border-radius:6px;
  font-size:14px;color:var(--txt-2);transition:background .14s ease,color .14s ease;
}
.lmenu a:hover{background:var(--surface);color:var(--txt)}
.lmenu a.on{color:var(--brand);font-weight:600}
.lb-f{font-size:15px;line-height:1}
.lb-c{width:15px;height:15px;margin-left:auto;color:var(--brand)}

/* bahasa di menu mobile */
.mlang{padding:14px 4px 4px;border-bottom:1px solid var(--line)}
.mlang h4{font-size:10.5px;letter-spacing:.13em;text-transform:uppercase;color:var(--txt-2);margin-bottom:9px;font-weight:700}
.mlrow{display:flex;gap:8px;flex-wrap:wrap}
.mlrow a{
  padding:8px 14px;border-radius:7px;font-size:14px;color:var(--txt-2);
  border:1px solid var(--line);background:var(--card);
}
.mlrow a.on{color:var(--brand);border-color:var(--pur);font-weight:600}

/* ---- SHEET ---- */
.sheet{
  position:absolute;left:0;right:0;top:100%;
  background:var(--bg);border-bottom:1px solid var(--line);
  box-shadow:0 14px 34px -16px rgba(0,0,0,.45);
  transform-origin:top center;
  animation:turun .26s cubic-bezier(.16,1,.3,1);
}
@keyframes turun{
  from{opacity:0;transform:translateY(-10px) scaleY(.97)}
  to{opacity:1;transform:none}
}
/* isi panel muncul bertahap */
.sheet .scol,.sheet .skaki{animation:naik .34s cubic-bezier(.16,1,.3,1) backwards}
.sheet .scol:nth-child(1){animation-delay:.03s}
.sheet .scol:nth-child(2){animation-delay:.07s}
.sheet .scol:nth-child(3){animation-delay:.11s}
.sheet .skaki{animation-delay:.11s}
@keyframes naik{from{opacity:0;transform:translateY(9px)}to{opacity:1;transform:none}}
.sgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(196px,1fr));gap:30px;padding-block:28px 30px;align-items:start}
.skaki{max-width:300px}
.scol h3{
  font-size:11px;letter-spacing:.13em;text-transform:uppercase;
  color:var(--txt-2);margin-bottom:12px;font-weight:700;
}
.sit{
  position:relative;display:flex;gap:12px;padding:9px 11px;border-radius:7px;margin-left:-11px;
  transition:background .18s var(--ease),transform .18s var(--ease);
}
.sit:hover{background:var(--surface);transform:translateX(3px)}
.sit::after{
  content:'';position:absolute;right:12px;top:50%;width:6px;height:6px;
  border-right:1.6px solid var(--brand);border-top:1.6px solid var(--brand);
  transform:translateY(-50%) rotate(45deg) translateX(-4px);
  opacity:0;transition:opacity .18s var(--ease),transform .18s var(--ease);
}
.sit:hover::after{opacity:1;transform:translateY(-50%) rotate(45deg) translateX(0)}
.sik{
  width:34px;height:34px;flex:none;border-radius:7px;display:grid;place-items:center;
  background:var(--surface);border:1px solid var(--line);color:var(--brand);
  transition:background .2s var(--ease),color .2s var(--ease),
             border-color .2s var(--ease),transform .2s var(--ease);
}
.sit:hover .sik{background:var(--pur);color:#fff;border-color:var(--pur);transform:scale(1.07)}
.sik svg{width:17px;height:17px}
.stx{display:flex;flex-direction:column;gap:1px}
.stx strong{font-size:14.5px;font-weight:600;color:var(--txt)}
.stx small{font-size:12.8px;color:var(--txt-2);line-height:1.45}
.skaki{
  border:1px solid var(--line);border-radius:8px;padding:18px;
  background:var(--card);box-shadow:var(--shadow);
}
.skaki p{font-size:13.5px;color:var(--txt-2);margin-bottom:12px;line-height:1.55}
.skaki .btn{width:100%}
@media(max-width:1120px){.sgrid{grid-template-columns:1fr 1fr;gap:26px}.skaki{grid-column:1/-1;max-width:none}}

#tabir{position:fixed;inset:84px 0 0;background:rgba(0,0,0,.34);z-index:-1;
  backdrop-filter:blur(2px);animation:pudar .26s ease}
@keyframes pudar{from{opacity:0}to{opacity:1}}

/* ---- MOBILE ---- */
#burger{display:none;flex-direction:column;gap:4.5px}
#burger span{width:17px;height:2px;background:currentColor;border-radius:2px;transition:.22s var(--ease)}
#burger[aria-expanded='true'] span:nth-child(1){transform:translateY(6.5px) rotate(45deg)}
#burger[aria-expanded='true'] span:nth-child(2){opacity:0}
#burger[aria-expanded='true'] span:nth-child(3){transform:translateY(-6.5px) rotate(-45deg)}
#mob{display:none;border-top:1px solid var(--line);background:var(--bg);padding:12px 0 22px;max-height:calc(100vh - 70px);overflow-y:auto}
#mob.open{display:block}
#mob .wrap{display:flex;flex-direction:column;gap:1px}
.mlink{padding:13px 4px;color:var(--txt-2);font-weight:500;border-bottom:1px solid var(--line)}
.mgrp{border-bottom:1px solid var(--line)}
.mgrp summary{
  display:flex;align-items:center;justify-content:space-between;
  padding:13px 4px;color:var(--txt-2);font-weight:500;cursor:pointer;list-style:none;font-size:16px;
}
.mgrp summary::-webkit-details-marker{display:none}
.mgrp summary svg{width:16px;height:16px;transition:transform .2s var(--ease)}
.mgrp[open] summary{color:var(--txt)}
.mgrp[open] summary svg{transform:rotate(180deg)}
.mbody{padding:2px 0 14px 4px}
.mbody h4{font-size:10.5px;letter-spacing:.13em;text-transform:uppercase;color:var(--txt-2);margin:12px 0 6px;font-weight:700}
.mbody a{display:block;padding:9px 0 9px 12px;font-size:14.5px;color:var(--txt-2);border-left:2px solid var(--line)}
.mbody a:hover{color:var(--brand);border-left-color:var(--pur)}

@media(max-width:1000px){.links,.cta,.sheet,#tabir,.lang{display:none!important}#burger{display:flex}}
@media(min-width:1001px){.only-m{display:none}}
@media(prefers-reduced-motion:reduce){
  .sheet,#tabir,.sheet .scol,.sheet .skaki,.lmenu{animation:none}
  .sit:hover{transform:none}
  .brand:hover img,.icon-btn:hover svg,.sit:hover .sik{transform:none}
}
</style>

<script>
  const nav = document.getElementById('nav');
  const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  /* ---------- SHEET DESKTOP ---------- */
  const pemicu = Array.from(document.querySelectorAll<HTMLButtonElement>('.trig'));
  const lembar = Array.from(document.querySelectorAll<HTMLElement>('.sheet'));
  const tabir = document.getElementById('tabir');
  let jedaTutup: number | undefined;

  const tutupSemua = () => {
    pemicu.forEach((p) => p.setAttribute('aria-expanded', 'false'));
    lembar.forEach((l) => (l.hidden = true));
    if (tabir) tabir.hidden = true;
    nav?.classList.remove('buka');
  };

  const buka = (i: number) => {
    window.clearTimeout(jedaTutup);
    pemicu.forEach((p) => p.setAttribute('aria-expanded', String(p.dataset.sheet === String(i))));
    lembar.forEach((l) => (l.hidden = l.dataset.panel !== String(i)));
    if (tabir) tabir.hidden = false;
    nav?.classList.add('buka');
  };

  pemicu.forEach((p) => {
    const i = Number(p.dataset.sheet);
    // klik untuk kunci buka/tutup
    p.addEventListener('click', (e) => {
      e.stopPropagation();
      p.getAttribute('aria-expanded') === 'true' ? tutupSemua() : buka(i);
    });
    // hover membuka, dengan jeda supaya tidak berkedip
    p.addEventListener('mouseenter', () => buka(i));
    p.addEventListener('mouseleave', () => {
      jedaTutup = window.setTimeout(tutupSemua, 170);
    });
  });

  lembar.forEach((l) => {
    l.addEventListener('mouseenter', () => window.clearTimeout(jedaTutup));
    l.addEventListener('mouseleave', () => {
      jedaTutup = window.setTimeout(tutupSemua, 170);
    });
    l.querySelectorAll('a').forEach((a) => a.addEventListener('click', tutupSemua));
  });

  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement)?.closest('#nav')) tutupSemua();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      tutupSemua();
      m?.classList.remove('open');
      b?.setAttribute('aria-expanded', 'false');
    }
  });

  /* ---------- MENU MOBILE ---------- */
  const b = document.getElementById('burger');
  const m = document.getElementById('mob');
  b?.addEventListener('click', () => {
    const open = m?.classList.toggle('open');
    b.setAttribute('aria-expanded', String(!!open));
  });
  m?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      m.classList.remove('open');
      b?.setAttribute('aria-expanded', 'false');
    })
  );

  /* ---------- PEMILIH BAHASA ---------- */
  const lbtn = document.getElementById('langbtn');
  const lmenu = document.getElementById('langmenu');
  lbtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const buka = lbtn.getAttribute('aria-expanded') !== 'true';
    lbtn.setAttribute('aria-expanded', String(buka));
    if (lmenu) lmenu.hidden = !buka;
  });
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement)?.closest('.lang')) {
      lbtn?.setAttribute('aria-expanded', 'false');
      if (lmenu) lmenu.hidden = true;
    }
  });
  // ingat pilihan bahasa untuk kunjungan berikutnya
  document.querySelectorAll<HTMLAnchorElement>('[data-setlang]').forEach((a) =>
    a.addEventListener('click', () => {
      try { localStorage.setItem('xy-lang', a.dataset.setlang!); } catch {}
    })
  );

  /* ---------- TEMA ---------- */
  document.getElementById('theme')?.addEventListener('click', () => {
    const el = document.documentElement;
    const next = el.dataset.theme === 'dark' ? 'light' : 'dark';
    el.dataset.theme = next;
    localStorage.setItem('xy-theme', next);
  });
</script>
