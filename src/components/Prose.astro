---
<div class="prose"><slot /></div>

<style is:global>
.prose{font-size:16.5px;line-height:1.78;color:var(--txt-2);max-width:70ch}
.prose > * + *{margin-top:1.15em}
.prose h2{font-size:clamp(21px,2.6vw,27px);color:var(--txt);margin-top:2em;margin-bottom:.1em;scroll-margin-top:96px}
.prose h3{font-size:19px;color:var(--txt);margin-top:1.7em;margin-bottom:.1em}
.prose strong{color:var(--txt);font-weight:600}
.prose a{color:var(--brand);font-weight:500;border-bottom:1px solid color-mix(in srgb,var(--pur) 40%,transparent)}
.prose a:hover{border-bottom-color:currentColor}
.prose ul,.prose ol{padding-left:1.3em;display:grid;gap:.5em}
.prose li{padding-left:.25em}
.prose li::marker{color:var(--brand)}
.prose code{
  font-family:ui-monospace,SFMono-Regular,monospace;font-size:.88em;
  background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:.15em .42em;color:var(--brand);
}
.prose pre{background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:18px;overflow-x:auto}
.prose pre code{background:none;border:0;padding:0;color:inherit}
.prose blockquote{
  border-left:3px solid var(--pur);padding:2px 0 2px 18px;color:var(--txt-2);font-style:italic;
}
.prose hr{border:0;border-top:1px solid var(--line);margin:2.2em 0}
.prose table{width:100%;border-collapse:collapse;font-size:15px;display:block;overflow-x:auto}
.prose th,.prose td{border:1px solid var(--line);padding:11px 14px;text-align:left}
.prose th{background:var(--surface);color:var(--txt);font-weight:600;white-space:nowrap}
.prose img{border-radius:8px;border:1px solid var(--line)}
</style>
