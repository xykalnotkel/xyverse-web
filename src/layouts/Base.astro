---
import { SITE, SOSMED } from '../data/site';
import { BAHASA, SEMUA_LANG, LANG_BAWAAN, langDariPath, tanpaPrefiks, type Lang } from '../i18n/config';
import { DESC_SITUS, TAGLINE } from '../i18n/data';
import { jalurOG } from '../lib/og';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/ui.css';

interface Props {
  title?: string;
  desc?: string;
  tipe?: 'website' | 'article';
  ogImage?: string;
  ogTitle?: string;
  ogTag?: string;
  terbit?: Date;
  diubah?: Date;
  penulis?: string;
  noindex?: boolean;
  jsonld?: any;
  lang?: Lang;
}

const langProp = (Astro.props as any).lang as Lang | undefined;
const lang: Lang = langProp ?? langDariPath(Astro.url.pathname);
const meta = BAHASA[lang];

const {
  title = `${SITE.nama} — ${TAGLINE[lang]}`,
  desc = DESC_SITUS[lang],
  tipe = 'website',
  ogImage,
  ogTitle,
  ogTag,
  terbit,
  diubah,
  penulis,
  noindex = false,
  jsonld,
} = Astro.props;

const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', SITE.url).href;

// OG image statis per halaman: /og/<slug>.svg (slug diturunkan dari path)
const jalurMurni = tanpaPrefiks(Astro.url.pathname);
const ogUrl = ogImage
  ? new URL(ogImage, SITE.url).href
  : new URL(`/og/${jalurOG(lang, ...jalurMurni.split('/').filter(Boolean))}.svg`, SITE.url).href;

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: SITE.nama,
  url: SITE.url,
  logo: `${SITE.url}/brand/mark-flat-purple.webp`,
  email: SITE.email,
  foundingDate: String(SITE.berdiri),
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.alamat.jalan,
    addressLocality: SITE.alamat.kota,
    addressRegion: SITE.alamat.provinsi,
    postalCode: SITE.alamat.pos,
    addressCountry: SITE.alamat.negaraKode,
  },
  sameAs: SOSMED.map((s) => s.url),
};

const siteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  url: SITE.url,
  name: SITE.nama,
  description: DESC_SITUS[lang],
  inLanguage: meta.htmlLang,
  publisher: { '@id': `${SITE.url}/#organization` },
};
---
<!doctype html>
<html lang={meta.htmlLang}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<title>{title}</title>
<meta name="description" content={desc} />
<link rel="canonical" href={canonical} />
{noindex
  ? <meta name="robots" content="noindex, nofollow" />
  : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}

<meta property="og:type" content={tipe} />
<meta property="og:site_name" content={SITE.nama} />
<meta property="og:locale" content={meta.ogLocale} />
{SEMUA_LANG.filter((l) => l !== lang).map((l) => (
  <meta property="og:locale:alternate" content={BAHASA[l].ogLocale} />
))}

<!-- hreflang: setiap halaman menunjuk ke padanannya di bahasa lain -->
{SEMUA_LANG.map((l) => (
  <link
    rel="alternate"
    hreflang={BAHASA[l].htmlLang}
    href={new URL(`/${l}/${jalurMurni}${jalurMurni ? '/' : ''}`, SITE.url).href}
  />
))}
<link rel="alternate" hreflang="x-default" href={new URL(`/${LANG_BAWAAN}/${jalurMurni}${jalurMurni ? '/' : ''}`, SITE.url).href} />
<meta property="og:title" content={ogTitle || title} />
<meta property="og:description" content={desc} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogTitle || title} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={ogTitle || title} />
<meta name="twitter:description" content={desc} />
<meta name="twitter:image" content={ogUrl} />
<meta name="twitter:site" content="@xyverse_id" />

{terbit && <meta property="article:published_time" content={terbit.toISOString()} />}
{diubah && <meta property="article:modified_time" content={diubah.toISOString()} />}
{penulis && <meta property="article:author" content={penulis} />}

<meta name="theme-color" content="#0a0812" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="author" content={SITE.nama} />
<meta name="geo.region" content="ID-NB" />
<meta name="geo.placename" content={SITE.alamat.kota} />

<link rel="icon" href="/brand/mark-flat-purple.webp" />
<link rel="apple-touch-icon" href="/brand/mark-flat-purple.webp" />
<link rel="manifest" href="/manifest.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={`Blog ${SITE.nama}`} href={`/${lang}/rss.xml`} />
<link rel="preload" href="/brand/Sora.ttf" as="font" type="font/ttf" crossorigin />

<script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
<script type="application/ld+json" set:html={JSON.stringify(siteLd)} />
{jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}

<script is:inline>
  (function () {
    const s = localStorage.getItem('xy-theme');
    const t = s || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
    document.documentElement.dataset.theme = t;
  })();
</script>

<style is:global>
@font-face{font-family:'Sora';src:url('/brand/Sora.ttf') format('truetype');font-weight:100 800;font-display:swap}
@font-face{font-family:'InterV';src:url('/brand/Inter.ttf') format('truetype');font-weight:100 900;font-display:swap}

:root{
  --pur:#7c3aed; --pur-d:#6d28d9; --pur-l:#9f7aea;
  --max:1200px; --r:10px;
  --rb:6px;                       /* radius tombol, gaya Cloudflare */
  --ease:cubic-bezier(.22,.8,.3,1);
}
html[data-theme='dark']{
  --bg:#0d0b14; --bg-2:#14111d; --surface:#1a1626; --card:#16131f;
  --card-h:#1b1726; --line:rgba(255,255,255,.1); --line-s:rgba(255,255,255,.2);
  --txt:#f1eff5; --txt-2:#9c97ad; --brand:#9f7aea;
  --glow:rgba(124,58,237,.1);
  --shadow:0 1px 2px rgba(0,0,0,.4);
  --shadow-h:0 4px 12px rgba(0,0,0,.35);
  --btn-txt:#ffffff;
  --btn-g-1:#211d2e; --btn-g-2:#191525;
  --btn-g-1h:#2a2539; --btn-g-2h:#211c2f;
  --btn-g-br:rgba(255,255,255,.16); --btn-g-brh:rgba(255,255,255,.26);
  --btn-g-in:rgba(255,255,255,.07); --btn-g-sh:rgba(0,0,0,.5);
  --btn-g-amb:rgba(0,0,0,.34); --btn-g-gloss:rgba(255,255,255,.06);
  /* status */
  --ok:#34d399;   --ok-bg:rgba(16,185,129,.13);   --ok-br:rgba(16,185,129,.34);
  --err:#f87171;  --err-bg:rgba(239,68,68,.13);   --err-br:rgba(239,68,68,.36);
  --warn:#fbbf24; --warn-bg:rgba(245,158,11,.13); --warn-br:rgba(245,158,11,.34);
  --info:#60a5fa; --info-bg:rgba(59,130,246,.13); --info-br:rgba(59,130,246,.34);
  --skel-1:rgba(255,255,255,.045); --skel-2:rgba(255,255,255,.1);
}
html[data-theme='light']{
  --bg:#ffffff; --bg-2:#f7f6f9; --surface:#f2f0f6; --card:#ffffff;
  --card-h:#ffffff; --line:rgba(20,15,40,.13); --line-s:rgba(20,15,40,.26);
  --txt:#16121f; --txt-2:#5c5670; --brand:#6d28d9;
  --glow:rgba(124,58,237,.07);
  --shadow:0 1px 2px rgba(20,15,40,.07);
  --shadow-h:0 4px 12px rgba(20,15,40,.1);
  --btn-txt:#ffffff;
  --btn-g-1:#ffffff; --btn-g-2:#f4f2f8;
  --btn-g-1h:#ffffff; --btn-g-2h:#ebe8f2;
  --btn-g-br:rgba(20,15,40,.2); --btn-g-brh:rgba(20,15,40,.32);
  --btn-g-in:rgba(255,255,255,.9); --btn-g-sh:rgba(20,15,40,.13);
  --btn-g-amb:rgba(20,15,40,.09); --btn-g-gloss:rgba(255,255,255,.75);
  /* status */
  --ok:#047857;   --ok-bg:rgba(16,185,129,.1);    --ok-br:rgba(4,120,87,.3);
  --err:#b91c1c;  --err-bg:rgba(239,68,68,.08);   --err-br:rgba(185,28,28,.28);
  --warn:#b45309; --warn-bg:rgba(245,158,11,.11); --warn-br:rgba(180,83,9,.28);
  --info:#1d4ed8; --info-bg:rgba(59,130,246,.09); --info-br:rgba(29,78,216,.26);
  --skel-1:rgba(20,15,40,.055); --skel-2:rgba(20,15,40,.11);
}

*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;scroll-padding-top:96px}
@media(max-width:1000px){html{scroll-padding-top:82px}}
body{
  background:var(--bg); color:var(--txt);
  font-family:'InterV',system-ui,-apple-system,'Segoe UI',sans-serif;
  font-size:16px; line-height:1.7; letter-spacing:-.011em;
  -webkit-font-smoothing:antialiased; overflow-x:hidden;
  transition:background .3s var(--ease), color .3s var(--ease);
}
h1,h2,h3,h4,.dsp{font-family:'Sora',system-ui,sans-serif;font-weight:700;line-height:1.14;letter-spacing:-.03em}
a{color:inherit;text-decoration:none}
img{max-width:100%;display:block}
::selection{background:var(--pur);color:#fff}
:focus-visible{outline:2px solid var(--pur);outline-offset:2px;border-radius:3px}

.wrap{max-width:var(--max);margin:0 auto;padding:0 28px}
@media(max-width:600px){.wrap{padding:0 20px}}
.sect{padding:112px 0;position:relative}
@media(max-width:760px){.sect{padding:76px 0}}

.eyebrow{
  display:inline-flex;align-items:center;gap:8px;
  font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;
  color:var(--brand);margin-bottom:16px;
}
.eyebrow::before{content:'';width:20px;height:1.5px;background:var(--brand);border-radius:2px}
.h2{font-size:clamp(27px,3.8vw,42px);margin-bottom:14px;max-width:16ch}
.lead{color:var(--txt-2);font-size:clamp(15.5px,1.6vw,17.5px);max-width:58ch;line-height:1.72}

/* Tombol: 2D tapi berdimensi — gradien halus, kilau tepi atas, ketebalan di bawah */
.btn{
  position:relative;
  display:inline-flex;align-items:center;justify-content:center;gap:8px;
  padding:9px 17px;border-radius:var(--rb);
  font-size:14px;font-weight:600;line-height:1.45;letter-spacing:-.005em;
  border:1px solid transparent;cursor:pointer;
  font-family:inherit;white-space:nowrap;text-align:center;
  transition:background .13s ease,border-color .13s ease,box-shadow .13s ease,
             color .13s ease,transform .06s ease;
}
/* kilau gloss di separuh atas */
.btn::before{
  content:'';position:absolute;inset:1px 1px auto 1px;height:46%;
  border-radius:calc(var(--rb) - 1px) calc(var(--rb) - 1px) 0 0;
  background:linear-gradient(180deg,rgba(255,255,255,.17),rgba(255,255,255,0));
  pointer-events:none;
}
.btn > *{position:relative;z-index:1}
.btn:focus-visible{outline:2px solid var(--pur);outline-offset:2px}
.btn:disabled,.btn[aria-disabled='true']{opacity:.55;pointer-events:none;box-shadow:none}

/* ---- utama: ungu dengan ketebalan ---- */
.btn-p{
  background:linear-gradient(180deg,#8b5cf6,#7c3aed);
  color:var(--btn-txt);border-color:#6d28d9;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.22),
    0 1px 0 #5b21b6,
    0 2px 4px rgba(20,10,50,.28);
}
.btn-p:hover{
  background:linear-gradient(180deg,#956bf7,#8250e8);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.26),
    0 1px 0 #5b21b6,
    0 3px 7px rgba(20,10,50,.32);
}
.btn-p:active{
  background:linear-gradient(180deg,#6d28d9,#6023c9);
  transform:translateY(1px);
  box-shadow:inset 0 2px 5px rgba(30,10,70,.4),0 0 0 rgba(0,0,0,0);
}

/* ---- sekunder: putih/gelap dengan ketebalan ---- */
.btn-g{
  background:linear-gradient(180deg,var(--btn-g-1),var(--btn-g-2));
  color:var(--txt);border-color:var(--btn-g-br);
  box-shadow:
    inset 0 1px 0 var(--btn-g-in),
    0 1px 0 var(--btn-g-sh),
    0 2px 4px var(--btn-g-amb);
}
.btn-g:hover{
  background:linear-gradient(180deg,var(--btn-g-1h),var(--btn-g-2h));
  border-color:var(--btn-g-brh);
}
.btn-g:active{
  background:var(--btn-g-2h);
  transform:translateY(1px);
  box-shadow:inset 0 2px 4px var(--btn-g-amb);
}
.btn-g::before{background:linear-gradient(180deg,var(--btn-g-gloss),transparent)}

/* ---- tersier: datar, tanpa dimensi ---- */
.btn-t{
  background:transparent;color:var(--brand);border-color:transparent;
  padding-inline:11px;box-shadow:none;
}
.btn-t::before{display:none}
.btn-t:hover{background:var(--surface)}
.btn-t:active{background:var(--line);transform:translateY(1px)}

/* ---- ukuran ---- */
.btn-lg{padding:12px 23px;font-size:15px}
.btn-sm{padding:6px 13px;font-size:13px}

.btn svg{width:16px;height:16px;flex:none;position:relative;z-index:1}

.card{
  background:var(--card);border:1px solid var(--line);border-radius:var(--r);
  padding:26px;position:relative;overflow:hidden;
  box-shadow:var(--shadow);
  transition:border-color .16s ease,box-shadow .16s ease,background .16s ease;
}
.card:hover{border-color:var(--line-s);box-shadow:var(--shadow-h);background:var(--card-h)}

.grid{display:grid;gap:20px}
.g2{grid-template-columns:repeat(2,1fr)}
.g3{grid-template-columns:repeat(3,1fr)}
.g4{grid-template-columns:repeat(4,1fr)}
@media(max-width:940px){.g3,.g4{grid-template-columns:repeat(2,1fr)}}
@media(max-width:680px){.g2,.g3,.g4{grid-template-columns:1fr}}

.reveal{opacity:0;transform:translateY(22px);transition:opacity .65s var(--ease),transform .65s var(--ease)}
.reveal.in{opacity:1;transform:none}
@media(prefers-reduced-motion:reduce){
  .reveal{opacity:1;transform:none;transition:none}
  *{animation-duration:.01ms !important;animation-iteration-count:1 !important}
}
</style>
</head>
<body>
<a href="#main" class="skip">Lewati ke konten</a>
<Nav />
<main id="main" class="isi-utama"><slot /></main>
<Footer />

<style>
.skip{position:absolute;left:-999px;top:10px;z-index:200;background:var(--pur);color:#fff;padding:9px 16px;border-radius:var(--rb)}
.skip:focus{left:20px}

/* ruang aman: footer menimpa 120px, jaga konten terakhir tidak tertutup */
.isi-utama{padding-bottom:120px}
@media(max-width:760px){.isi-utama{padding-bottom:80px}}
</style>

<script>
  const io = new IntersectionObserver(
    (es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }),
    { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
  );
  document.querySelectorAll('.reveal').forEach((el) => {
    const g = el.closest('.grid');
    if (g) {
      const i = [...g.children].indexOf(el);
      (el as HTMLElement).style.transitionDelay = `${Math.min(i, 5) * 65}ms`;
    }
    io.observe(el);
  });
</script>
</body>
</html>
