---
import { BAHASA, rute } from '../../../i18n/config';
import { pakaiT } from '../../../i18n/ui';
import { APL } from '../../../i18n/halaman/aplikasi';
import { APLIKASI_TEKS } from '../../../i18n/data';

import Base from '../../../layouts/Base.astro';
import Bagikan from '../../../components/Bagikan.astro';
import { SITE, APLIKASI } from '../../../data/site';
import { urlOG } from '../../../lib/og';

export function getStaticPaths() {
  const LANGS = ['id', 'en'] as const;
  return LANGS.flatMap((lang) =>
    APLIKASI.map((a) => ({ params: { lang, slug: a.slug }, props: { app: a, lang } }))
  );
}

const { app, lang } = Astro.props;
const t = pakaiT(lang);
const r = (p = '') => rute(lang, p);
const lain = APLIKASI.filter((a) => a.slug !== app.slug);

const c = APL[lang];
const ta = APLIKASI_TEKS[lang][app.slug];
const unduh = c.unduh[app.slug];
const faq = c.faq[app.slug];

const path = r(`aplikasi/${app.slug}`);

const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: app.nama,
      description: ta.desc,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: app.platform.join(', '),
      url: `${SITE.url}${path}`,
      softwareVersion: '1.0',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'IDR', availability: 'https://schema.org/InStock' },
      publisher: { '@type': 'Organization', name: SITE.nama, url: SITE.url },
      featureList: ta.fitur.map((f) => f.t),
      image: urlOG(SITE.url, lang, 'aplikasi', app.slug),
      inLanguage: BAHASA[lang].htmlLang,
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: c.beranda, item: new URL(r(), SITE.url).href },
        { '@type': 'ListItem', position: 2, name: c.eyebrow, item: new URL(r('aplikasi'), SITE.url).href },
        { '@type': 'ListItem', position: 3, name: app.nama },
      ],
    },
  ],
};
---

<Base
  lang={lang}
  title={`${app.nama} — ${ta.tagline} | ${SITE.nama}`}
  desc={ta.desc}
  ogTitle={`${app.nama} — ${ta.tagline}`}
  ogTag={c.ogTag}
  jsonld={ld}
>
  <section class="hero" style={`--c:${app.warna}`}>
    <div class="wrap">
      <nav class="crumb" aria-label={c.remah}>
        <a href={r()}>{c.beranda}</a><span>/</span><a href={r('aplikasi')}>{c.eyebrow}</a><span>/</span><span aria-current="page">{app.nama}</span>
      </nav>

      <div class="hgrid">
        <div>
          <span class="logo">{app.nama.slice(0, 2)}</span>
          <h1>{app.nama}</h1>
          <p class="tl">{ta.tagline}</p>
          <p class="lead">{ta.desc}</p>
          <div class="act">
            <a href={r('harga')} class="btn btn-p">{c.langganan}</a>
            <a href="#unduh" class="btn btn-g">{c.unduhOpsi}</a>
          </div>
          <ul class="plat">
            {app.platform.map((p) => <li>{p}</li>)}
          </ul>
        </div>

        <div class="mock" aria-hidden="true">
          <div class="bar"><i></i><i></i><i></i></div>
          <div class="body">
            <div class="row"><span class="dot"></span><span class="ln w1"></span></div>
            <div class="row"><span class="dot"></span><span class="ln w2"></span></div>
            <div class="row"><span class="dot on"></span><span class="ln w3"></span></div>
            <div class="row"><span class="dot"></span><span class="ln w2"></span></div>
            <div class="stat"><b>{app.slug === 'xydesk' ? '18 ms' : '99,9%'}</b><small>{app.slug === 'xydesk' ? 'latensi rata-rata' : 'uptime bulan ini'}</small></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="sect">
    <div class="wrap">
      <h2 class="st">{c.fiturH2}</h2>
      <div class="grid g3">
        {ta.fitur.map((f, i) => (
          <div class="card reveal fcard">
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{f.t}</h3>
            <p>{f.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sect" id="unduh">
    <div class="wrap">
      <h2 class="st">{c.tersediaH2}</h2>
      <div class="dl">
        {unduh.map((u) => (
          <div class="dcard reveal">
            <div>
              <strong>{u.p}</strong>
              <small>{u.v}</small>
            </div>
            <span class="pill">{u.f}</span>
          </div>
        ))}
      </div>
      <p class="hint">{c.hintUnduh}</p>
    </div>
  </section>

  <section class="sect">
    <div class="wrap">
      <h2 class="st">{c.faqH2}</h2>
      <div class="faq">
        {faq.map((f, i) => (
          <details class="reveal" open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>

      <div class="share"><Bagikan judul={`${app.nama} — ${ta.tagline}`} path={path} ringkas={ta.desc} /></div>

      <div class="lain">
        <h2 class="st">{c.lainH2}</h2>
        {lain.map((a) => (
          <a href={r(`aplikasi/${a.slug}`)} class="lcard" style={`--c:${a.warna}`}>
            <span class="logo sm">{a.nama.slice(0, 2)}</span>
            <div><strong>{a.nama}</strong><small>{APLIKASI_TEKS[lang][a.slug].tagline}</small></div>
            <span class="go">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
.hero{padding:48px 0 18px;position:relative;overflow:hidden;border-bottom:1px solid var(--line)}
.hero::before{content:'';position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse 55% 60% at 20% 0%,color-mix(in srgb,var(--c) 18%,transparent),transparent 70%)}
.hero .wrap{position:relative;z-index:2}
.crumb{display:flex;gap:9px;flex-wrap:wrap;font-size:13px;color:var(--txt-2);margin-bottom:26px}
.crumb a:hover{color:var(--brand)}
.hgrid{display:grid;grid-template-columns:1fr 380px;gap:48px;align-items:center;padding-bottom:40px}
@media(max-width:940px){.hgrid{grid-template-columns:1fr;gap:34px}}
.logo{
  width:60px;height:60px;border-radius:7px;display:grid;place-items:center;margin-bottom:18px;
  background:var(--c);color:#fff;font-weight:800;font-size:20px;
}
.logo.sm{width:42px;height:42px;border-radius:8px;font-size:14px;margin:0}
h1{font-size:clamp(32px,5vw,50px);margin-bottom:6px}
.tl{font-size:17px;color:var(--c);font-weight:600;margin-bottom:14px}
.lead{max-width:52ch}
.act{display:flex;gap:11px;flex-wrap:wrap;margin:24px 0 18px}
.plat{display:flex;flex-wrap:wrap;gap:6px;list-style:none;padding:0}
.plat li{font-size:11.5px;font-weight:600;padding:4px 10px;border-radius:7px;background:var(--surface);border:1px solid var(--line);color:var(--txt-2)}

.mock{border:1px solid var(--line);border-radius:7px;overflow:hidden;background:var(--card);box-shadow:0 22px 60px -24px rgba(0,0,0,.45)}
.bar{display:flex;gap:6px;padding:11px 14px;border-bottom:1px solid var(--line);background:var(--surface)}
.bar i{width:9px;height:9px;border-radius:50%;background:var(--line-s)}
.mock .body{padding:18px}
.row{display:flex;align-items:center;gap:10px;margin-bottom:12px}
.dot{width:8px;height:8px;border-radius:50%;background:var(--line-s);flex-shrink:0}
.dot.on{background:var(--c);box-shadow:0 0 10px var(--c)}
.ln{height:9px;border-radius:5px;background:var(--surface)}
.w1{width:72%}.w2{width:54%}.w3{width:84%;background:color-mix(in srgb,var(--c) 30%,var(--surface))}
.stat{margin-top:20px;padding-top:16px;border-top:1px solid var(--line)}
.stat b{display:block;font-size:30px;color:var(--c);letter-spacing:-1px}
.stat small{font-size:12.5px;color:var(--txt-2)}

.st{font-size:23px;margin-bottom:20px}
.fcard .num{font-size:12px;font-weight:800;color:var(--brand);letter-spacing:.1em}
.fcard h3{font-size:16.5px;margin:8px 0 7px}
.fcard p{font-size:14.2px;color:var(--txt-2)}

.dl{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px}
.dcard{
  display:flex;align-items:center;justify-content:space-between;gap:14px;
  border:1px solid var(--line);border-radius:8px;padding:16px 18px;background:var(--card);
}
.dcard strong{display:block;font-size:15px}
.dcard small{font-size:12.5px;color:var(--txt-2)}
.pill{font-size:11.5px;font-weight:700;padding:5px 11px;border-radius:999px;background:var(--surface);border:1px solid var(--line);color:var(--txt-2);white-space:nowrap}
.hint{margin-top:16px;font-size:13.5px;color:var(--txt-2)}

.faq{display:grid;gap:10px}
details{border:1px solid var(--line);border-radius:8px;background:var(--card);overflow:hidden}
summary{padding:16px 20px;cursor:pointer;font-weight:600;font-size:15.3px;list-style:none;display:flex;justify-content:space-between;gap:14px}
summary::-webkit-details-marker{display:none}
summary::after{content:'+';color:var(--brand);font-size:20px;line-height:1;transition:.22s var(--ease)}
details[open] summary::after{transform:rotate(45deg)}
details p{padding:0 20px 18px;color:var(--txt-2);font-size:14.4px;line-height:1.72}

.share{margin-top:40px;padding-top:20px;border-top:1px solid var(--line)}
.lain{margin-top:36px}
.lcard{
  display:flex;align-items:center;gap:14px;border:1px solid var(--line);border-radius:7px;
  padding:16px 18px;background:var(--card);transition:.25s var(--ease);
}
.lcard:hover{border-color:color-mix(in srgb,var(--c) 42%,transparent)}
.lcard strong{display:block;font-size:15.5px}
.lcard small{font-size:13px;color:var(--txt-2)}
.lcard .go{margin-left:auto;color:var(--brand);font-size:19px}
</style>
