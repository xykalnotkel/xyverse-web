---
import { rute } from '../../../i18n/config';
import { pakaiT } from '../../../i18n/ui';
import Base from '../../../layouts/Base.astro';
import Prose from '../../../components/Prose.astro';
import Daftar from '../../../components/Daftar.astro';
import Progres from '../../../components/Progres.astro';
import Bagikan from '../../../components/Bagikan.astro';
import { getCollection, render } from 'astro:content';
import { slugKonten, filterLang } from '../../../i18n/data';
import { KOLEKSI } from '../../../i18n/halaman/koleksi';
import { SITE } from '../../../data/site';
import { BAHASA } from '../../../i18n/config';
import { urlOG } from '../../../lib/og';

export async function getStaticPaths() {
  const LANGS = ['id', 'en'] as const;
  const semua = await getCollection('berita');
  return LANGS.flatMap((lang) =>
    semua.filter(filterLang(lang)).map((x) => ({ params: { lang, id: slugKonten(x.id) }, props: { p: x, lang } }))
  );
}

const { p, lang } = Astro.props;
const t = pakaiT(lang);
const r = (x = '') => rute(lang, x);
const { Content, headings } = await render(p);

const K = KOLEKSI[lang];
const c = K.berita;
const all = (await getCollection('berita', filterLang(lang))).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const idx = all.findIndex((x) => x.id === p.id);
const lain = all.filter((x) => x.id !== p.id).slice(0, 3);
const sebelum = all[idx + 1];
const sesudah = all[idx - 1];

const fmt = (d: Date) => d.toLocaleDateString(lang === 'en' ? 'en-GB' : 'id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
const path = r(`berita/${slugKonten(p.id)}`);
const url = new URL(path, SITE.url).href;

const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'NewsArticle',
      headline: p.data.title,
      description: p.data.desc,
      datePublished: p.data.date.toISOString(),
      dateModified: p.data.date.toISOString(),
      author: { '@type': 'Organization', name: SITE.nama, url: SITE.url },
      publisher: {
        '@type': 'Organization',
        name: SITE.nama,
        url: SITE.url,
        logo: { '@type': 'ImageObject', url: `${SITE.url}/brand/mark-flat-purple.webp` },
      },
      mainEntityOfPage: { '@type': 'WebPage', '@id': url },
      image: urlOG(SITE.url, lang, 'berita', slugKonten(p.id)),
      articleSection: p.data.tag,
      inLanguage: BAHASA[lang].htmlLang,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: K.beranda, item: new URL(r(), SITE.url).href },
        { '@type': 'ListItem', position: 2, name: K.beritaCrumb, item: new URL(r('berita'), SITE.url).href },
        { '@type': 'ListItem', position: 3, name: p.data.title },
      ],
    },
  ],
};
---

<Base
  lang={lang}
  title={`${p.data.title} — Berita Xyverse`}
  desc={p.data.desc}
  tipe="article"
  ogTag={p.data.tag}
  terbit={p.data.date}
  jsonld={ld}
>
  <Progres />

  <article>
    <header class="ah">
      <div class="wrap narrow">
        <nav class="crumb" aria-label={K.remah}>
          <a href={r()}>{K.beranda}</a><span>/</span><a href={r('berita')}>{K.beritaCrumb}</a><span>/</span><span aria-current="page">{p.data.tag}</span>
        </nav>
        <div class="m">
          <span class="tag">{p.data.tag}</span>
          <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
        </div>
        <h1>{p.data.title}</h1>
        <p class="lead">{p.data.desc}</p>
      </div>
    </header>

    <div class="wrap narrow body">
      <Daftar headings={headings} />
      <Prose><Content /></Prose>

      <div class="fshare"><Bagikan judul={p.data.title} path={path} ringkas={p.data.desc} /></div>

      <div class="cta">
        <p>{c.ctaP}</p>
        <a href={`mailto:${SITE.email}`} class="btn btn-g">{SITE.email}</a>
      </div>

      {(sebelum || sesudah) && (
        <nav class="pn" aria-label={c.navArtikel}>
          {sebelum ? (
            <a href={r(`berita/${slugKonten(sebelum.id)}`)} class="pncard">
              <small>← {K.sebelumnya}</small><strong>{sebelum.data.title}</strong>
            </a>
          ) : <span />}
          {sesudah ? (
            <a href={r(`berita/${slugKonten(sesudah.id)}`)} class="pncard r">
              <small>{K.berikutnya} →</small><strong>{sesudah.data.title}</strong>
            </a>
          ) : <span />}
        </nav>
      )}
    </div>

    {lain.length > 0 && (
      <section class="sect" style="padding-top:12px">
        <div class="wrap">
          <h2 class="h2" style="margin-bottom:24px">{c.lainH2}</h2>
          <div class="grid g3">
            {lain.map((x) => (
              <a href={r(`berita/${slugKonten(x.id)}`)} class="card next">
                <span class="tag">{x.data.tag}</span>
                <h3>{x.data.title}</h3>
                <p>{x.data.desc}</p>
                <small>{fmt(x.data.date)}</small>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </article>
</Base>

<style>
.narrow{max-width:760px}
.ah{padding:46px 0 30px;position:relative;overflow:hidden}
.ah::before{content:'';position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse 60% 60% at 30% 0%,var(--glow),transparent 70%)}
.ah .wrap{position:relative;z-index:2}
.crumb{display:flex;gap:9px;flex-wrap:wrap;font-size:13px;color:var(--txt-2);margin-bottom:20px}
.crumb a:hover{color:var(--brand)}
.m{display:flex;align-items:center;gap:11px;margin-bottom:16px;flex-wrap:wrap}
.tag{font-size:11.5px;font-weight:600;padding:5px 11px;border-radius:6px;background:color-mix(in srgb,var(--pur) 14%,transparent);border:1px solid color-mix(in srgb,var(--pur) 28%,transparent);color:var(--brand)}
.m time{font-size:13.5px;color:var(--txt-2)}
h1{font-size:clamp(27px,4.2vw,40px);margin-bottom:14px}
.body{padding-bottom:50px}
.fshare{margin-top:44px;padding-top:18px;border-top:1px solid var(--line)}
.cta{display:flex;justify-content:space-between;align-items:center;gap:18px;flex-wrap:wrap;margin-top:24px;padding-top:24px;border-top:1px solid var(--line)}
.cta p{color:var(--txt-2);font-size:15px}
.pn{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:26px}
@media(max-width:640px){.pn{grid-template-columns:1fr}}
.pncard{border:1px solid var(--line);border-radius:8px;padding:16px 18px;background:var(--card);transition:.24s var(--ease)}
.pncard:hover{border-color:color-mix(in srgb,var(--pur) 42%,transparent);}
.pncard small{display:block;font-size:12px;color:var(--brand);font-weight:600;margin-bottom:5px}
.pncard strong{font-size:14.8px;line-height:1.4}
.pncard.r{text-align:right}
.next h3{font-size:17px;margin:8px 0 8px}
.next p{color:var(--txt-2);font-size:14.3px}
.next small{display:block;margin-top:12px;font-size:12.5px;color:var(--txt-2)}
</style>
