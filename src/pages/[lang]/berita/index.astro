---
import { jalurBahasa, rute } from '../../../i18n/config';
import { pakaiT } from '../../../i18n/ui';

export function getStaticPaths() { return jalurBahasa(); }

const { lang } = Astro.props;
const t = pakaiT(lang);
const r = (p = '') => rute(lang, p);
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import Sampul from '../../../components/Sampul.astro';
import { getCollection } from 'astro:content';
import { slugKonten, filterLang } from '../../../i18n/data';
import { KOLEKSI } from '../../../i18n/halaman/koleksi';

const K = KOLEKSI[lang];
const c = K.berita;
const items = (await getCollection('berita', filterLang(lang))).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const fmt = (d: Date) => d.toLocaleDateString(lang === 'en' ? 'en-GB' : 'id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base lang={lang} title={c.metaTitle} desc={c.metaDesc}>
  <PageHead
    eyebrow={c.eyebrow}
    title={c.judul}
    lead={c.lead}
  />

  <section class="sect" style="padding-top:44px">
    <div class="wrap narrow">
      <ol class="feed">
        {items.map((n) => (
          <li class="reveal">
            <a href={r(`berita/${slugKonten(n.id)}`)} class="item">
              <div class="dot"></div>
              <div class="c">
                <Sampul src={n.data.gambar} alt={n.data.title} rasio="21 / 9" />
                <div class="m">
                  <span class="tag">{n.data.tag}</span>
                  <time datetime={n.data.date.toISOString()}>{fmt(n.data.date)}</time>
                </div>
                <h2>{n.data.title}</h2>
                <p>{n.data.desc}</p>
                <span class="more">Baca selengkapnya →</span>
              </div>
            </a>
          </li>
        ))}
      </ol>

      <div class="muat-lagi" id="muat" hidden>
        <button type="button" class="tombol" id="tombol-muat">
          <span id="teks-muat"></span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </button>
      </div>
    </div>
  </section>
</Base>

<style>
.narrow{max-width:800px}
.feed{list-style:none;position:relative;padding-left:28px}
.feed::before{content:'';position:absolute;left:5px;top:12px;bottom:12px;width:1.5px;background:var(--line)}
.feed li + li{margin-top:14px}
.item{display:block;position:relative;border:1px solid var(--line);border-radius:var(--r);background:var(--card);padding:24px;transition:.25s var(--ease)}
.item:hover{border-color:var(--line-s);box-shadow:var(--shadow)}
.dot{position:absolute;left:-28px;top:28px;width:11px;height:11px;border-radius:50%;background:var(--pur);box-shadow:0 0 0 4px var(--bg)}
.m{display:flex;align-items:center;gap:11px;margin-bottom:11px;flex-wrap:wrap}
.tag{font-size:11.5px;font-weight:600;padding:4px 10px;border-radius:6px;background:color-mix(in srgb,var(--pur) 14%,transparent);border:1px solid color-mix(in srgb,var(--pur) 28%,transparent);color:var(--brand)}
.m time{font-size:13px;color:var(--txt-2)}
.item h2{font-size:20px;margin-bottom:8px;line-height:1.3}
.item p{color:var(--txt-2);font-size:14.8px}
.more{display:inline-block;margin-top:14px;font-size:13.5px;font-weight:600;color:var(--brand)}
.muat-lagi{display:flex;justify-content:center;margin-top:30px}
.tombol{
  display:inline-flex;align-items:center;gap:9px;padding:12px 22px;cursor:pointer;
  background:var(--card);border:1px solid var(--line);border-radius:8px;color:var(--txt);
  font:inherit;font-size:14.5px;font-weight:500;transition:.2s var(--ease);
}
.tombol:hover{border-color:color-mix(in srgb,var(--pur) 50%,transparent);transform:translateY(-1px)}
.tombol svg{width:15px;height:15px;color:var(--brand)}
</style>

<script define:vars={{ lblLebih: K.lebihBanyak, lblDari: K.dari, TIAP: 10 }}>
  /*
   * Feed berita tidak punya penyaring, jadi tidak ada perebutan `display`
   * seperti di halaman blog — cukup sembunyikan sisanya dan tambahkan
   * segenggam tiap klik.
   */
  const baris = Array.from(document.querySelectorAll('.feed > li')) as HTMLElement[];
  const kotak = document.getElementById('muat');
  const tombol = document.getElementById('tombol-muat');
  const teks = document.getElementById('teks-muat');
  let tampil = TIAP;

  function terapkan() {
    baris.forEach((li, i) => { li.style.display = i < tampil ? '' : 'none'; });
    const sisa = baris.length - tampil;
    if (kotak) kotak.hidden = sisa <= 0;
    if (teks && sisa > 0) teks.textContent = `${lblLebih} (${Math.min(TIAP, sisa)} ${lblDari} ${sisa})`;
  }
  tombol?.addEventListener('click', () => { tampil += TIAP; terapkan(); });
  terapkan();
</script>
