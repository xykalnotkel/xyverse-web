---
import { rute } from '../../../i18n/config';
import { pakaiT } from '../../../i18n/ui';
import Base from '../../../layouts/Base.astro';
import Prose from '../../../components/Prose.astro';
import Daftar from '../../../components/Daftar.astro';
import Progres from '../../../components/Progres.astro';
import Bagikan from '../../../components/Bagikan.astro';
import { getCollection, render } from 'astro:content';
import { slugKonten, filterLang } from '../../../i18n/data';
import { KOLEKSI } from '../../../i18n/halaman/koleksi';
import { SITE } from '../../../data/site';
import { BAHASA } from '../../../i18n/config';
import { urlOG } from '../../../lib/og';
import { gambarOG } from '../../../lib/gambar';

export async function getStaticPaths() {
  const LANGS = ['id', 'en'] as const;
  const semua = await getCollection('blog');
  return LANGS.flatMap((lang) =>
    semua.filter(filterLang(lang)).map((x) => ({ params: { lang, id: slugKonten(x.id) }, props: { p: x, lang } }))
  );
}

const { p, lang } = Astro.props;
const t = pakaiT(lang);
const r = (x = '') => rute(lang, x);
const { Content, headings } = await render(p);
// Sampul asli dipakai untuk og:image bila ada; kalau tidak, generator SVG.
const ogGambar = gambarOG(SITE.url, p.data) ?? urlOG(SITE.url, lang, 'blog', slugKonten(p.id));

const K = KOLEKSI[lang];
const c = K.blog;
const all = (await getCollection('blog', filterLang(lang))).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// Terkait: prioritaskan kategori sama, lalu isi sisanya dengan yang terbaru
const idx = all.findIndex((x) => x.id === p.id);
const sekategori = all.filter((x) => x.id !== p.id && x.data.kategori === p.data.kategori);
const sisa = all.filter((x) => x.id !== p.id && x.data.kategori !== p.data.kategori);
const lain = [...sekategori, ...sisa].slice(0, 3);

const sebelum = all[idx + 1];
const sesudah = all[idx - 1];

const fmt = (d: Date) => d.toLocaleDateString(lang === 'en' ? 'en-GB' : 'id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
const path = r(`blog/${slugKonten(p.id)}`);
const url = new URL(path, SITE.url).href;

const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: p.data.title,
      description: p.data.desc,
      datePublished: p.data.date.toISOString(),
      dateModified: (p.data.diperbarui ?? p.data.date).toISOString(),
      author: { '@type': 'Person', name: p.data.penulis },
      publisher: {
        '@type': 'Organization',
        name: SITE.nama,
        url: SITE.url,
        logo: { '@type': 'ImageObject', url: `${SITE.url}/brand/mark-flat-purple.webp` },
      },
      mainEntityOfPage: { '@type': 'WebPage', '@id': url },
      image: ogGambar,
      articleSection: p.data.kategori,
      inLanguage: BAHASA[lang].htmlLang,
      wordCount: p.body?.split(/\s+/).length ?? undefined,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: K.beranda, item: new URL(r(), SITE.url).href },
        { '@type': 'ListItem', position: 2, name: K.blogCrumb, item: new URL(r('blog'), SITE.url).href },
        { '@type': 'ListItem', position: 3, name: p.data.title },
      ],
    },
  ],
};
---

<Base
  lang={lang}
  title={`${p.data.title} — Blog Xyverse`}
  desc={p.data.desc}
  tipe="article"
  ogImage={ogGambar}
  ogTag={p.data.kategori}
  terbit={p.data.date}
  diubah={p.data.diperbarui}
  penulis={p.data.penulis}
  jsonld={ld}
>
  <Progres />

  <article>
    <header class="ah">
      <div class="wrap narrow">
        <nav class="crumb" aria-label={K.remah}>
          <a href={r()}>{K.beranda}</a><span>/</span><a href={r('blog')}>{K.blogCrumb}</a><span>/</span><span aria-current="page">{p.data.kategori}</span>
        </nav>
        <span class="tag">{p.data.kategori}</span>
        <h1>{p.data.title}</h1>
        <p class="lead">{p.data.desc}</p>
        <div class="byline">
          <span class="av">{p.data.penulis.charAt(0)}</span>
          <div>
            <strong>{p.data.penulis}</strong>
            <span><time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time> · {p.data.baca} {K.menitBaca}</span>
          </div>
          <div class="hshare"><Bagikan judul={p.data.title} path={path} ringkas={p.data.desc} /></div>
        </div>
      </div>
    </header>

    <div class="wrap narrow body">
      <Daftar headings={headings} />
      <Prose><Content /></Prose>

      <div class="fshare"><Bagikan judul={p.data.title} path={path} ringkas={p.data.desc} /></div>

      <div class="cta">
        <div>
          <h2>{c.ctaH2}</h2>
          <p>{c.ctaP}</p>
        </div>
        <a href={r('kontak')} class="btn btn-p">{c.ctaB}</a>
      </div>

      {(sebelum || sesudah) && (
        <nav class="pn" aria-label={c.navArtikel}>
          {sebelum ? (
            <a href={r(`blog/${slugKonten(sebelum.id)}`)} class="pncard">
              <small>← {K.sebelumnya}</small>
              <strong>{sebelum.data.title}</strong>
            </a>
          ) : <span />}
          {sesudah ? (
            <a href={r(`blog/${slugKonten(sesudah.id)}`)} class="pncard r">
              <small>{K.berikutnya} →</small>
              <strong>{sesudah.data.title}</strong>
            </a>
          ) : <span />}
        </nav>
      )}
    </div>

    {lain.length > 0 && (
      <section class="sect" style="padding-top:20px">
        <div class="wrap">
          <h2 class="h2" style="margin-bottom:24px">{c.lainH2}</h2>
          <div class="grid g3">
            {lain.map((x) => (
              <a href={r(`blog/${slugKonten(x.id)}`)} class="card next">
                <span class="tag">{x.data.kategori}</span>
                <h3>{x.data.title}</h3>
                <p>{x.data.desc}</p>
                <small>{fmt(x.data.date)} · {x.data.baca} {K.menit}</small>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </article>
</Base>

<style>
.narrow{max-width:780px}
.ah{padding:46px 0 30px;position:relative;overflow:hidden}
.ah::before{content:'';position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse 60% 60% at 30% 0%,var(--glow),transparent 70%)}
.ah .wrap{position:relative;z-index:2}
.crumb{display:flex;gap:9px;flex-wrap:wrap;font-size:13px;color:var(--txt-2);margin-bottom:20px}
.crumb a:hover{color:var(--brand)}
.tag{display:inline-block;font-size:11.5px;font-weight:600;padding:5px 11px;border-radius:6px;background:color-mix(in srgb,var(--pur) 14%,transparent);border:1px solid color-mix(in srgb,var(--pur) 28%,transparent);color:var(--brand);margin-bottom:16px}
h1{font-size:clamp(28px,4.4vw,42px);margin-bottom:16px}
.byline{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:26px;padding-top:22px;border-top:1px solid var(--line)}
.av{width:40px;height:40px;border-radius:50%;display:grid;place-items:center;background:var(--pur);color:#fff;font-weight:700;font-size:16px;flex:none}
.byline strong{display:block;font-size:14.5px}
.byline > div:not(.hshare) span{font-size:13px;color:var(--txt-2)}
.hshare{margin-left:auto}
.hshare :global(.lbl){display:none}
.hshare :global(.bagikan){padding:0}
@media(max-width:760px){.hshare{margin-left:0;width:100%}}
.body{padding-bottom:40px}
.fshare{margin-top:44px;padding-top:18px;border-top:1px solid var(--line)}
.cta{
  display:flex;justify-content:space-between;align-items:center;gap:22px;flex-wrap:wrap;
  margin-top:30px;padding:26px 28px;border-radius:var(--r);
  border:1px solid var(--line);background:var(--card);
}
.cta h2{font-size:18px;margin-bottom:5px}
.cta p{color:var(--txt-2);font-size:14.5px}
.pn{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:22px}
@media(max-width:640px){.pn{grid-template-columns:1fr}}
.pncard{border:1px solid var(--line);border-radius:8px;padding:16px 18px;background:var(--card);transition:.24s var(--ease)}
.pncard:hover{border-color:color-mix(in srgb,var(--pur) 42%,transparent);}
.pncard small{display:block;font-size:12px;color:var(--brand);font-weight:600;margin-bottom:5px}
.pncard strong{font-size:14.8px;line-height:1.4}
.pncard.r{text-align:right}
.next h3{font-size:17.5px;margin:4px 0 8px}
.next p{color:var(--txt-2);font-size:14.5px}
.next small{display:block;margin-top:12px;font-size:12.5px;color:var(--txt-2)}
</style>
