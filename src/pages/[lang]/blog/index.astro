---
import { jalurBahasa, rute } from '../../../i18n/config';
import { pakaiT } from '../../../i18n/ui';

export function getStaticPaths() { return jalurBahasa(); }

const { lang } = Astro.props;
const t = pakaiT(lang);
const r = (p = '') => rute(lang, p);
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import Kosong from '../../../components/Kosong.astro';
import Sampul from '../../../components/Sampul.astro';
import { getCollection } from 'astro:content';
import { slugKonten, filterLang } from '../../../i18n/data';
import { KOLEKSI } from '../../../i18n/halaman/koleksi';

const posts = (await getCollection('blog', filterLang(lang))).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const K = KOLEKSI[lang];
const c = K.blog;
const kategori = [...new Set(posts.map((p) => p.data.kategori))];
const fmt = (d: Date) => d.toLocaleDateString(lang === 'en' ? 'en-GB' : 'id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base lang={lang} title={c.metaTitle} desc={c.metaDesc}>
  <PageHead
    eyebrow={c.eyebrow}
    title={c.judul}
    lead={c.lead}
  />

  <section class="sect" style="padding-top:44px">
    <div class="wrap">
      <div class="filters reveal">
        <button class="chip on" data-k="all">{K.semua}</button>
        {kategori.map((k) => <button class="chip" data-k={k}>{k}</button>)}
      </div>

      <div class="grid g3" id="list">
        {posts.map((p) => (
          <a href={r(`blog/${slugKonten(p.id)}`)} class="card reveal post" data-k={p.data.kategori}>
            <Sampul src={p.data.gambar} alt={p.data.title} rasio="16 / 10" />
            <div class="meta">
              <span class="tag">{p.data.kategori}</span>
              {p.data.unggulan && <span class="tag hi">{K.unggulan}</span>}
            </div>
            <h2>{p.data.title}</h2>
            <p>{p.data.desc}</p>
            <div class="foot">
              <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
              <span>{p.data.baca} {K.menitBaca}</span>
            </div>
          </a>
        ))}
      </div>
      <div id="empty" hidden><Kosong judul={c.kosong} /></div>

      <div class="muat-lagi" id="muat" hidden>
        <button type="button" class="tombol" id="tombol-muat">
          <span id="teks-muat"></span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </button>
      </div>
    </div>
  </section>
</Base>

<style>
.filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:28px}
.chip{
  padding:8px 16px;border-radius:6px;font-size:13.5px;font-weight:500;cursor:pointer;
  background:var(--card);border:1px solid var(--line);color:var(--txt-2);
  font-family:inherit;transition:.2s var(--ease);
}
.chip:hover{color:var(--txt);border-color:var(--line-s)}
.chip.on{background:var(--pur);border-color:var(--pur);color:#fff}
.post{display:flex;flex-direction:column}
.meta{display:flex;gap:7px;margin-bottom:14px;flex-wrap:wrap}
.tag{font-size:11.5px;font-weight:600;padding:4px 10px;border-radius:6px;background:var(--surface);border:1px solid var(--line);color:var(--txt-2)}
.tag.hi{background:color-mix(in srgb,var(--pur) 15%,transparent);border-color:color-mix(in srgb,var(--pur) 30%,transparent);color:var(--brand)}
.post h2{font-size:19px;margin-bottom:9px;line-height:1.3}
.post p{color:var(--txt-2);font-size:14.5px;flex:1}
.foot{
  display:flex;justify-content:space-between;gap:10px;margin-top:20px;padding-top:15px;
  border-top:1px solid var(--line);font-size:12.5px;color:var(--txt-2);
}
.muat-lagi{display:flex;justify-content:center;margin-top:34px}
.tombol{
  display:inline-flex;align-items:center;gap:9px;padding:12px 22px;cursor:pointer;
  background:var(--card);border:1px solid var(--line);border-radius:8px;color:var(--txt);
  font:inherit;font-size:14.5px;font-weight:500;transition:.2s var(--ease);
}
.tombol:hover{border-color:color-mix(in srgb,var(--pur) 50%,transparent);transform:translateY(-1px)}
.tombol svg{width:15px;height:15px;color:var(--brand)}
</style>

<script define:vars={{ lblLebih: K.lebihBanyak, lblDari: K.dari, TIAP: 12 }}>
  /**
   * Penyaring kategori dan muat bertahap dalam satu tempat.
   *
   * Keduanya harus satu sumber kebenaran karena keduanya menyembunyikan
   * item. Kalau dipisah, yang satu akan menimpa `display` yang lain dan
   * item muncul atau hilang tanpa sebab. Aturannya sederhana: sebuah kartu
   * tampil hanya bila cocok dengan kategori DAN berada di dalam batas.
   *
   * Batas diterapkan pada hasil penyaringan, bukan pada seluruh daftar —
   * jadi memilih "Teknis" menampilkan 12 artikel Teknis pertama, bukan
   * 12 kartu teratas yang kebetulan Teknis-nya cuma dua.
   */
  const chips = Array.from(document.querySelectorAll('.chip')) as HTMLButtonElement[];
  const posts = Array.from(document.querySelectorAll('.post')) as HTMLElement[];
  const empty = document.getElementById('empty');
  const kotakMuat = document.getElementById('muat');
  const tombolMuat = document.getElementById('tombol-muat');
  const teksMuat = document.getElementById('teks-muat');

  let kategoriAktif = 'all';
  let tampil = TIAP;

  const cocok = (p: HTMLElement) => kategoriAktif === 'all' || p.dataset.k === kategoriAktif;

  function terapkan() {
    const lulus = posts.filter(cocok);
    lulus.forEach((p, i) => { p.style.display = i < tampil ? '' : 'none'; });
    posts.forEach((p) => { if (!cocok(p)) p.style.display = 'none'; });

    if (empty) empty.hidden = lulus.length > 0;
    const sisa = lulus.length - tampil;
    if (kotakMuat) kotakMuat.hidden = sisa <= 0;
    if (teksMuat && sisa > 0) teksMuat.textContent = `${lblLebih} (${Math.min(TIAP, sisa)} ${lblDari} ${sisa})`;
  }

  chips.forEach((c) =>
    c.addEventListener('click', () => {
      chips.forEach((x) => x.classList.toggle('on', x === c));
      kategoriAktif = c.dataset.k || 'all';
      tampil = TIAP; // kategori baru mulai dari awal lagi
      terapkan();
    })
  );
  tombolMuat?.addEventListener('click', () => { tampil += TIAP; terapkan(); });
  terapkan();
</script>
