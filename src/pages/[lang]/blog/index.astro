---
import { jalurBahasa, rute } from '../../../i18n/config';
import { pakaiT } from '../../../i18n/ui';

export function getStaticPaths() { return jalurBahasa(); }

const { lang } = Astro.props;
const t = pakaiT(lang);
const r = (p = '') => rute(lang, p);
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import Kosong from '../../../components/Kosong.astro';
import { getCollection } from 'astro:content';
import { slugKonten, filterLang } from '../../../i18n/data';
import { KOLEKSI } from '../../../i18n/halaman/koleksi';

const posts = (await getCollection('blog', filterLang(lang))).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const K = KOLEKSI[lang];
const c = K.blog;
const kategori = [...new Set(posts.map((p) => p.data.kategori))];
const fmt = (d: Date) => d.toLocaleDateString(lang === 'en' ? 'en-GB' : 'id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base lang={lang} title={c.metaTitle} desc={c.metaDesc}>
  <PageHead
    eyebrow={c.eyebrow}
    title={c.judul}
    lead={c.lead}
  />

  <section class="sect" style="padding-top:44px">
    <div class="wrap">
      <div class="filters reveal">
        <button class="chip on" data-k="all">{K.semua}</button>
        {kategori.map((k) => <button class="chip" data-k={k}>{k}</button>)}
      </div>

      <div class="grid g3" id="list">
        {posts.map((p) => (
          <a href={r(`blog/${slugKonten(p.id)}`)} class="card reveal post" data-k={p.data.kategori}>
            <div class="meta">
              <span class="tag">{p.data.kategori}</span>
              {p.data.unggulan && <span class="tag hi">{K.unggulan}</span>}
            </div>
            <h2>{p.data.title}</h2>
            <p>{p.data.desc}</p>
            <div class="foot">
              <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
              <span>{p.data.baca} menit baca</span>
            </div>
          </a>
        ))}
      </div>
      <div id="empty" hidden><Kosong judul={c.kosong} /></div>
    </div>
  </section>
</Base>

<style>
.filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:28px}
.chip{
  padding:8px 16px;border-radius:6px;font-size:13.5px;font-weight:500;cursor:pointer;
  background:var(--card);border:1px solid var(--line);color:var(--txt-2);
  font-family:inherit;transition:.2s var(--ease);
}
.chip:hover{color:var(--txt);border-color:var(--line-s)}
.chip.on{background:var(--pur);border-color:var(--pur);color:#fff}
.post{display:flex;flex-direction:column}
.meta{display:flex;gap:7px;margin-bottom:14px;flex-wrap:wrap}
.tag{font-size:11.5px;font-weight:600;padding:4px 10px;border-radius:6px;background:var(--surface);border:1px solid var(--line);color:var(--txt-2)}
.tag.hi{background:color-mix(in srgb,var(--pur) 15%,transparent);border-color:color-mix(in srgb,var(--pur) 30%,transparent);color:var(--brand)}
.post h2{font-size:19px;margin-bottom:9px;line-height:1.3}
.post p{color:var(--txt-2);font-size:14.5px;flex:1}
.foot{
  display:flex;justify-content:space-between;gap:10px;margin-top:20px;padding-top:15px;
  border-top:1px solid var(--line);font-size:12.5px;color:var(--txt-2);
}
</style>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const posts = document.querySelectorAll<HTMLElement>('.post');
  const empty = document.getElementById('empty');
  chips.forEach((c) =>
    c.addEventListener('click', () => {
      chips.forEach((x) => x.classList.toggle('on', x === c));
      const k = c.dataset.k;
      let n = 0;
      posts.forEach((p) => {
        const show = k === 'all' || p.dataset.k === k;
        p.style.display = show ? '' : 'none';
        if (show) n++;
      });
      if (empty) empty.hidden = n > 0;
    })
  );
</script>
