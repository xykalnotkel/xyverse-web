---
import { jalurBahasa, rute } from '../../i18n/config';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Sampul from '../../components/Sampul.astro';
import { KOLEKSI } from '../../i18n/halaman/koleksi';
import { getCollection } from 'astro:content';
import { filterLang } from '../../i18n/data';

export function getStaticPaths() { return jalurBahasa(); }

const { lang } = Astro.props;
const K = KOLEKSI[lang];
const c = K.cari;

// Jenis dipakai untuk membangun penyaring di server supaya labelnya sudah
// ter-i18n tanpa perlu kamus tambahan di sisi klien.
const jumlah: Record<string, number> = {};
for (const col of ['blog', 'berita', 'proyek', 'legal'] as const) {
  const n = (await getCollection(col, filterLang(lang))).length;
  if (n) jumlah[col] = n;
}
const LABEL_JENIS: Record<string, Record<string, string>> = {
  blog: { id: 'Blog', en: 'Blog' },
  berita: { id: 'Berita', en: 'News' },
  proyek: { id: 'Proyek', en: 'Project' },
  legal: { id: 'Legal', en: 'Legal' },
};
---

<Base lang={lang} title={c.metaTitle} desc={c.metaDesc}>
  <PageHead eyebrow={c.eyebrow} title={c.judul} lead={c.lead} />

  <section class="sect" style="padding-top:36px">
    <div class="wrap narrow">
      <div class="kotak reveal">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
        </svg>
        <input
          id="q"
          type="search"
          autocomplete="off"
          placeholder={c.placeholder}
          aria-label={c.judul}
          data-pintasan={c.pintasan}
        />
        <kbd aria-hidden="true">/</kbd>
      </div>

      <div class="filters reveal" id="jenis">
        <button class="chip on" data-t="all">{c.semuaJenis}</button>
        {Object.keys(jumlah).map((k) => (
          <button class="chip" data-t={LABEL_JENIS[k][lang]}>{LABEL_JENIS[k][lang]}</button>
        ))}
      </div>

      <p class="ringkas" id="ringkas" aria-live="polite">{c.memuat}</p>
      <div class="hasil" id="hasil"></div>
      <div class="kosong" id="kosong" hidden>
        <h2>{c.kosongJudul}</h2>
        <p>{c.kosongIsi} <a href={rute(lang, 'kontak')}>{c.kosongTautan}</a>.</p>
      </div>
    </div>
  </section>

  <template id="tpl">
    <a id="tpl-baris" class="baris">
      <span class="b-gambar"></span>
      <span class="b-isi">
        <span class="b-atas"><span class="b-jenis"></span><span class="b-tgl"></span></span>
        <strong class="b-judul"></strong>
        <span class="b-desc"></span>
      </span>
    </a>
  </template>
</Base>

<style>
.narrow{max-width:820px}
.kotak{
  display:flex;align-items:center;gap:12px;padding:14px 18px;margin-bottom:20px;
  background:var(--card);border:1px solid var(--line);border-radius:var(--r);
  transition:.2s var(--ease);
}
.kotak:focus-within{border-color:color-mix(in srgb,var(--pur) 55%,transparent);box-shadow:0 0 0 3px color-mix(in srgb,var(--pur) 14%,transparent)}
.kotak svg{width:19px;height:19px;color:var(--brand);flex:none}
.kotak input{
  flex:1;min-width:0;background:none;border:0;outline:0;color:var(--txt);
  font:inherit;font-size:16.5px;
}
.kotak input::placeholder{color:var(--txt-2);opacity:.75}
.kotak kbd{
  flex:none;font:600 11px/1 ui-monospace,monospace;padding:5px 7px;border-radius:5px;
  background:var(--surface);border:1px solid var(--line);color:var(--txt-2);
}
.kotak:focus-within kbd{opacity:.35}
.filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px}
.chip{
  padding:7px 14px;border-radius:6px;font-size:13px;font-weight:500;cursor:pointer;
  background:var(--card);border:1px solid var(--line);color:var(--txt-2);
  font-family:inherit;transition:.2s var(--ease);
}
.chip:hover{color:var(--txt);border-color:var(--line-s)}
.chip.on{background:var(--pur);border-color:var(--pur);color:#fff}
.ringkas{font-size:13px;color:var(--txt-2);margin-bottom:16px;min-height:1.4em}
.hasil{display:grid;gap:10px}
.baris{
  display:flex;gap:16px;padding:16px 18px;text-align:left;
  background:var(--card);border:1px solid var(--line);border-radius:var(--r);
  transition:.2s var(--ease);
}
.baris:hover{border-color:color-mix(in srgb,var(--pur) 45%,transparent);transform:translateY(-1px)}
.b-gambar{display:none;flex:none;width:96px;height:64px;border-radius:6px;overflow:hidden;background:var(--surface);border:1px solid var(--line)}
.b-gambar img{width:100%;height:100%;object-fit:cover;display:block}
.baris.ada-gambar .b-gambar{display:block}
.b-isi{display:grid;gap:5px;min-width:0}
.b-atas{display:flex;gap:9px;align-items:center;font-size:11.5px;color:var(--txt-2)}
.b-jenis{font-weight:600;padding:3px 8px;border-radius:5px;background:var(--surface);border:1px solid var(--line)}
.b-judul{font-size:16px;color:var(--txt);line-height:1.35}
.b-desc{font-size:14px;color:var(--txt-2);line-height:1.55}
.kosong{padding:44px 0;text-align:center}
.kosong h2{font-size:20px;margin-bottom:8px}
.kosong p{color:var(--txt-2);font-size:14.5px;max-width:46ch;margin:0 auto}
.kosong a{color:var(--brand);border-bottom:1px solid color-mix(in srgb,var(--pur) 40%,transparent)}
@media (max-width:600px){
  .baris.ada-gambar .b-gambar{display:none}
}
</style>

<script define:vars={{ lang, labelHasil: c.hasil, labelSatu: c.hasilSatu }}>
  /**
   * Pencarian di sisi klien.
   *
   * Indeks diunduh sekali lalu disimpan di memori; setiap ketikan mencarinya
   * lagi tanpa permintaan jaringan. Skor dibuat sederhana dan mudah
   * diprediksi: kecocokan judul bernilai jauh lebih tinggi daripada
   * kecocokan deskripsi, dan seluruh kata kunci harus muncul di suatu tempat
   * (AND) supaya "cloud pc" tidak mengembalikan semua yang menyebut salah
   * satunya saja.
   */
  const hapusDiakritik = (s) =>
    String(s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');

  const kotak = document.getElementById('q');
  const wadah = document.getElementById('hasil');
  const ringkas = document.getElementById('ringkas');
  const kosong = document.getElementById('kosong');
  const tpl = document.getElementById('tpl');
  const chips = Array.from(document.querySelectorAll('#jenis .chip'));
  const MAKS = 30;

  let indeks = [];
  let jenisAktif = 'all';

  function cari(q) {
    const kata = hapusDiakritik(q).split(/\s+/).filter(Boolean);
    if (!kata.length) return [];
    const hasil = [];
    for (const b of indeks) {
      if (jenisAktif !== 'all' && b.t !== jenisAktif) continue;
      const judul = hapusDiakritik(b.j);
      let skor = 0;
      let semua = true;
      for (const k of kata) {
        const diJudul = judul.includes(k);
        const diMana = b._cari.includes(k);
        if (!diMana) { semua = false; break; }
        skor += diJudul ? 100 : 10;
        if (judul.startsWith(k)) skor += 40;
      }
      if (semua) hasil.push({ b, skor });
    }
    hasil.sort((x, y) => y.skor - x.skor || String(y.b.w).localeCompare(String(x.b.w)));
    return hasil.slice(0, MAKS).map((x) => x.b);
  }

  function gambar(baris) {
    if (baris.gambar) baris.gambar.innerHTML = '';
    baris.classList.remove('ada-gambar');
    if (!baris.g) return;
    const img = document.createElement('img');
    img.src = baris.g;
    img.alt = '';
    img.loading = 'lazy';
    img.decoding = 'async';
    baris.gambar.appendChild(img);
    baris.classList.add('ada-gambar');
  }

  function gambarUlang(q) {
    const ketemu = cari(q);
    wadah.innerHTML = '';
    for (const b of ketemu) {
      const simpul = tpl.content.firstElementChild.cloneNode(true);
      simpul.href = b.u;
      simpul.querySelector('.b-judul').textContent = b.j;
      simpul.querySelector('.b-desc').textContent = b.d || '';
      simpul.querySelector('.b-jenis').textContent = b.t;
      simpul.querySelector('.b-tgl').textContent = b.w || '';
      simpul.gambar = simpul.querySelector('.b-gambar');
      gambar(simpul);
      wadah.appendChild(simpul);
    }
    const n = ketemu.length;
    if (!q.trim()) ringkas.textContent = String(indeks.length) + ' ' + labelHasil;
    else ringkas.textContent = String(n) + ' ' + (n === 1 ? labelSatu : labelHasil);
    kosong.hidden = !(q.trim() && n === 0);
  }

  let tunggu;
  kotak.addEventListener('input', () => {
    clearTimeout(tunggu);
    const q = kotak.value;
    tunggu = setTimeout(() => gambarUlang(q), 120);
  });

  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      chips.forEach((x) => x.classList.toggle('on', x === chip));
      jenisAktif = chip.dataset.t;
      gambarUlang(kotak.value);
    })
  );

  // "/" memfokuskan kolom pencarian — kebiasaan dari situs dokumentasi.
  document.addEventListener('keydown', (e) => {
    const sedang = /^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement?.tagName || '');
    if (e.key === '/' && !sedang) { e.preventDefault(); kotak.focus(); }
    if (e.key === 'Escape' && document.activeElement === kotak) kotak.blur();
  });

  // ?q=… supaya hasil pencarian bisa dibagikan sebagai tautan.
  const awal = new URLSearchParams(location.search).get('q');
  if (awal) { kotak.value = awal; }

  /*
   * Indeks diambil belakangan dan tanpa `await` di tingkat atas: `define:vars`
   * membuat skrip ini non-module, dan `await` tingkat atas di sana tidak bisa
   * diandalkan. Kolom pencarian tetap bisa dipakai sejak halaman tampil; kalau
   * indeksnya belum datang, hasilnya kosong sebentar lalu terisi sendiri.
   */
  fetch('/indeks.json')
    .then((r) => (r.ok ? r.json() : {}))
    .catch(() => ({}))
    .then((muat) => {
      indeks = (muat && muat[lang]) || [];
      for (const baris of indeks) {
        baris._cari = hapusDiakritik([baris.j, baris.d, (baris.k || []).join(' ')].join(' '));
      }
      gambarUlang(kotak.value);
    });
</script>
