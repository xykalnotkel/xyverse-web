---
import { jalurBahasa, rute } from '../../i18n/config';
import { pakaiT } from '../../i18n/ui';
import { CHANGELOG } from '../../i18n/halaman/changelog';

export function getStaticPaths() { return jalurBahasa(); }

const { lang } = Astro.props;
const t = pakaiT(lang);
const r = (p = '') => rute(lang, p);
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { SITE } from '../../data/site';

const c = CHANGELOG[lang];
const rilis = c.rilis;

const warna: Record<string, string> = { tambah: '#10b981', ubah: '#f59e0b', perbaiki: '#3b82f6', hapus: '#ef4444' };
const label: Record<string, string> = c.label;

const ld = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: c.ldName,
  url: `${SITE.url}/changelog`,
  description: c.ldDesc,
};
---

<Base
  lang={lang}
  title={`${c.metaTitle} — ${SITE.nama}`}
  desc={c.metaDesc}
  ogTag={c.ogTag}
  jsonld={ld}
>
  <PageHead
    eyebrow={c.eyebrow}
    title={c.judul}
    lead={c.lead}
  />

  <section class="sect" style="padding-top:36px">
    <div class="wrap">
      <div class="filter">
        <button class="fb aktif" data-f="semua">{c.semua}</button>
        <button class="fb" data-f="tambah">{c.label.tambah}</button>
        <button class="fb" data-f="ubah">{c.label.ubah}</button>
        <button class="fb" data-f="perbaiki">{c.label.perbaiki}</button>
        <button class="fb" data-f="hapus">{c.label.hapus}</button>
      </div>

      <ol class="tl">
        {rilis.map((rel: any) => (
          <li class="rel reveal" data-jenis={rel.item.map((i: any) => i.t).join(' ')}>
            <div class="rkiri">
              <span class={`ver ${rel.jenis}`}>v{rel.v}</span>
              <time datetime={rel.tgl}>{rel.tglT}</time>
            </div>
            <div class="rkanan">
              <h2>{rel.judul}</h2>
              <ul class="perub">
                {rel.item.map((i: any) => (
                  <li data-t={i.t}>
                    <span class="badge" style={`--bc:${warna[i.t]}`}>{label[i.t]}</span>
                    <span class="dsc">{i.d}</span>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ol>

      <div class="cta reveal">
        <h2>{c.ctaH2}</h2>
        <p>{c.ctaP}</p>
        <div class="act">
          <a href={r('berita')} class="btn btn-p">{c.ctaB1}</a>
          <a href={r('komunitas')} class="btn btn-g">{c.ctaB2}</a>
          <a href={`/${lang}/rss.xml`} class="btn btn-t">{c.ctaB3}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
.filter{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:30px}
.fb{
  font-family:inherit;font-size:13px;font-weight:600;cursor:pointer;
  padding:6px 13px;border-radius:999px;
  background:var(--card);border:1px solid var(--line-s);color:var(--txt-2);
  transition:background .14s ease,color .14s ease,border-color .14s ease;
}
.fb:hover{background:var(--surface);color:var(--txt)}
.fb.aktif{background:var(--pur);border-color:var(--pur);color:#fff}

.tl{list-style:none;padding:0;position:relative}
.tl::before{content:'';position:absolute;left:7px;top:8px;bottom:8px;width:1px;background:var(--line)}
@media(max-width:760px){.tl::before{display:none}}
.rel{display:grid;grid-template-columns:190px 1fr;gap:28px;padding:0 0 32px 0;position:relative}
@media(max-width:760px){.rel{grid-template-columns:1fr;gap:12px}}
.rel::before{
  content:'';position:absolute;left:3px;top:7px;width:9px;height:9px;border-radius:50%;
  background:var(--pur);border:2px solid var(--bg);
}
@media(max-width:760px){.rel::before{display:none}}
.rkiri{padding-left:30px}
@media(max-width:760px){.rkiri{padding-left:0;display:flex;align-items:center;gap:11px}}
.ver{
  display:inline-block;font-size:13px;font-weight:700;font-family:ui-monospace,monospace;
  padding:3px 10px;border-radius:6px;margin-bottom:5px;
  background:var(--surface);border:1px solid var(--line);color:var(--txt);
}
.ver.fitur{border-color:color-mix(in srgb,#10b981 40%,transparent);color:#10b981}
.rkiri time{display:block;font-size:13px;color:var(--txt-2)}
@media(max-width:760px){.ver{margin-bottom:0}}
.rkanan h2{font-size:18.5px;margin-bottom:12px}
.perub{list-style:none;padding:0;display:grid;gap:9px}
.perub li{display:flex;gap:11px;align-items:flex-start}
.badge{
  font-size:10.5px;font-weight:700;letter-spacing:.03em;padding:3px 8px;border-radius:5px;
  white-space:nowrap;flex:none;margin-top:2px;
  background:color-mix(in srgb,var(--bc) 13%,transparent);
  border:1px solid color-mix(in srgb,var(--bc) 32%,transparent);
  color:var(--bc);
}
.dsc{font-size:14.3px;color:var(--txt-2);line-height:1.65}

.cta{
  margin-top:6px;border:1px solid var(--line);border-radius:12px;padding:34px;
  background:var(--card);text-align:center;box-shadow:var(--shadow);
}
.cta h2{font-size:21px;margin-bottom:9px}
.cta p{color:var(--txt-2);font-size:15px;max-width:54ch;margin:0 auto 20px}
.cta .act{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
</style>

<script>
  const tombol = Array.from(document.querySelectorAll<HTMLButtonElement>('.fb'));
  tombol.forEach((b) =>
    b.addEventListener('click', () => {
      tombol.forEach((x) => x.classList.toggle('aktif', x === b));
      const f = b.dataset.f;
      document.querySelectorAll<HTMLElement>('.rel').forEach((rel) => {
        let ada = 0;
        rel.querySelectorAll<HTMLElement>('.perub li').forEach((li) => {
          const cocok = f === 'semua' || li.dataset.t === f;
          li.style.display = cocok ? '' : 'none';
          if (cocok) ada++;
        });
        rel.style.display = ada ? '' : 'none';
      });
    })
  );
</script>
