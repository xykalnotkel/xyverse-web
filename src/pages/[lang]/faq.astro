---
import { jalurBahasa, rute } from '../../i18n/config';
import { pakaiT } from '../../i18n/ui';
import { FAQ_HAL } from '../../i18n/halaman/faq';

export function getStaticPaths() { return jalurBahasa(); }

const { lang } = Astro.props;
const t = pakaiT(lang);
const r = (p = '') => rute(lang, p);
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { SITE } from '../../data/site';

const c = FAQ_HAL[lang];
const grup = c.grup;

const IK = {
  info: '<circle cx="12" cy="12" r="9.2"/><path d="M12 11v5.5M12 7.6v.5"/>',
  server: '<rect x="3" y="3.5" width="18" height="7" rx="2"/><rect x="3" y="13.5" width="18" height="7" rx="2"/><path d="M7 7h.01M7 17h.01"/>',
  card: '<rect x="2.5" y="5" width="19" height="14" rx="2.4"/><path d="M2.5 10h19M6 14.5h4"/>',
  lock: '<rect x="4" y="10.5" width="16" height="10.5" rx="2.2"/><path d="M7.8 10.5V7.4a4.2 4.2 0 0 1 8.4 0v3.1"/>',
  help: '<circle cx="12" cy="12" r="9.2"/><path d="M9.4 9.4a2.7 2.7 0 0 1 5.2.9c0 1.8-2.6 2.2-2.6 3.9M12 17.4v.4"/>',
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: grup.flatMap((g: any) =>
    g.q.map((q: any) => ({
      '@type': 'Question',
      name: q.t,
      acceptedAnswer: { '@type': 'Answer', text: q.j },
    }))
  ),
};
const total = grup.reduce((a: number, g: any) => a + g.q.length, 0);
---

<Base
  lang={lang}
  title={`${c.metaTitle} — ${SITE.nama}`}
  desc={`${total}${c.metaDescB}`}
  ogTag={c.metaTitle}
  jsonld={faqLd}
>
  <PageHead
    eyebrow={c.eyebrow}
    title={c.judul}
    lead={`${total}${c.leadB}`}
  />

  <section class="sect" style="padding-top:36px">
    <div class="wrap">
      <div class="cari reveal">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6"/></svg>
        <input type="search" id="q" placeholder={c.cariPh} autocomplete="off" />
      </div>
      <p class="hasil" id="hasil" hidden></p>

      <div class="isi">
        {grup.map((g: any) => (
          <section class="grup reveal" data-grup>
            <h2 class="gh">
              <span class="gik">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={IK[g.ik]} />
              </span>
              {g.k}
              <span class="jml">{g.q.length}</span>
            </h2>
            <div class="qs">
              {g.q.map((q: any) => (
                <details class="qa" data-q={`${q.t} ${q.j}`.toLowerCase()}>
                  <summary>
                    <span>{q.t}</span>
                    <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                  </summary>
                  <p>{q.j}</p>
                </details>
              ))}
            </div>
          </section>
        ))}
      </div>

      <div class="cta reveal">
        <h2>{c.ctaH2}</h2>
        <p>{c.ctaP}</p>
        <div class="act">
          <a href={r('kontak')} class="btn btn-p">{c.ctaB1}</a>
          <a href={r('panduan')} class="btn btn-g">{c.ctaB2}</a>
          <a href={r('komunitas')} class="btn btn-t">{c.ctaB3}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script define:vars={{ COCOK: c.cocokA, TIDAK: c.tidakA, TIDAKB: c.tidakB }}>
  const q = document.getElementById('q');
  const hasil = document.getElementById('hasil');
  const semua = [...document.querySelectorAll('.qa')];
  const grup = [...document.querySelectorAll('[data-grup]')];
  q?.addEventListener('input', () => {
    const v = q.value.trim().toLowerCase();
    if (!v) {
      semua.forEach((e) => { e.hidden = false; e.open = false; });
      grup.forEach((g) => (g.hidden = false));
      hasil.hidden = true;
      return;
    }
    let n = 0;
    semua.forEach((e) => {
      const ok = e.dataset.q.includes(v);
      e.hidden = !ok;
      e.open = ok;
      if (ok) n++;
    });
    grup.forEach((g) => {
      g.hidden = ![...g.querySelectorAll('.qa')].some((e) => !e.hidden);
    });
    hasil.hidden = false;
    hasil.textContent = n ? `${n} ${COCOK} "${q.value.trim()}"` : `${TIDAK} "${q.value.trim()}" ${TIDAKB}`;
  });
</script>

<style>
.cari{display:flex;align-items:center;gap:11px;border:1px solid var(--line);border-radius:9px;
  padding:0 15px;background:var(--card);box-shadow:var(--shadow);transition:border-color .15s ease,box-shadow .15s ease}
.cari:focus-within{border-color:var(--pur);box-shadow:0 0 0 3px rgba(139,92,246,.09)}
.cari svg{width:17px;height:17px;color:var(--txt-2);flex:none}
.cari input{flex:1;border:0;outline:0;background:transparent;color:var(--txt);
  font:inherit;font-size:15px;padding:13px 0}
.hasil{margin-top:11px;font-size:13.5px;color:var(--txt-2)}

.isi{display:grid;gap:34px;margin-top:30px}
.gh{display:flex;align-items:center;gap:11px;font-size:19px;margin-bottom:14px}
.gik{width:32px;height:32px;border-radius:8px;display:grid;place-items:center;flex:none;
  background:var(--surface);border:1px solid var(--line);color:var(--brand)}
.gik svg{width:16px;height:16px}
.jml{font-size:11.5px;font-weight:700;padding:2px 9px;border-radius:999px;
  background:var(--surface);border:1px solid var(--line);color:var(--txt-2)}

.qs{display:grid;gap:8px}
.qa{border:1px solid var(--line);border-radius:10px;background:var(--card);
  box-shadow:var(--shadow);overflow:hidden;transition:border-color .15s ease}
.qa[open]{border-color:var(--line-s)}
.qa summary{display:flex;align-items:center;justify-content:space-between;gap:14px;
  padding:15px 18px;cursor:pointer;font-size:15px;font-weight:600;list-style:none;
  transition:background .14s ease}
.qa summary::-webkit-details-marker{display:none}
.qa summary:hover{background:var(--card-h)}
.chev{width:16px;height:16px;flex:none;color:var(--txt-2);transition:transform .2s ease}
.qa[open] .chev{transform:rotate(180deg)}
.qa p{padding:0 18px 17px;font-size:14.2px;color:var(--txt-2);line-height:1.72;max-width:76ch}

.cta{margin-top:44px;border:1px solid var(--line);border-radius:12px;padding:34px;
  background:var(--card);text-align:center;box-shadow:var(--shadow)}
.cta h2{font-size:21px;margin-bottom:9px}
.cta p{color:var(--txt-2);font-size:15px;max-width:56ch;margin:0 auto 20px}
.cta .act{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
@media(prefers-reduced-motion:reduce){.chev{transition:none}}
</style>
