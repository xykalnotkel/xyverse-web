---
import { jalurBahasa, rute } from '../../i18n/config';
import Pilih from '../../components/Pilih.astro';
import Pesan from '../../components/Pesan.astro';
import Ikon from '../../components/Ikon.astro';
import { URL_PESAN, HONEYPOT } from '../../lib/pesan';
import { pakaiT } from '../../i18n/ui';
import { BERANDA } from '../../i18n/halaman/beranda';

export function getStaticPaths() { return jalurBahasa(); }

const { lang } = Astro.props;
const t = pakaiT(lang);
const r = (p = '') => rute(lang, p);
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { slugKonten, filterLang } from '../../i18n/data';

const proyekTop = (await getCollection('proyek', filterLang(lang)))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 2);
const blogTop = (await getCollection('blog', filterLang(lang)))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const fmtD = (d: Date) => d.toLocaleDateString(lang === 'id' ? 'id-ID' : 'en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

const c = BERANDA[lang];

const icons: Record<string, string> = {
  cloud: '<path d="M17.5 19a4.5 4.5 0 0 0 .5-8.97A6.5 6.5 0 0 0 5.2 11.2 3.9 3.9 0 0 0 6 19z"/>',
  app: '<rect x="6" y="2" width="12" height="20" rx="2.5"/><path d="M11 18.5h2"/>',
  code: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
  tool: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
};
const arrow = '<path d="M5 12h14M13 6l6 6-6 6"/>';
---

<Base lang={lang}>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="wrap hero-in">
      <div class="hero-txt">
        <span class="pill"><i></i> {c.pill}</span>
        <h1>{c.h1a}<em>{c.h1em}</em>{c.h1b}</h1>
        <p class="lead">
          {c.leadA}<strong>{c.leadB}</strong>{c.leadC}<strong>{c.leadD}</strong>{c.leadE}
        </p>
        <div class="cta-row">
          <a href={r('cloud-pc')} class="btn btn-p">{c.ctaSewa} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={arrow} /></a>
          <a href={r() + '#layanan'} class="btn btn-g">{c.ctaLayanan}</a>
        </div>
        <p class="micro">{c.micro}</p>
      </div>

      <figure class="hero-art">
        <img src="/brand/illus-dark.webp" alt={c.altIlus} class="d" width="668" height="590" fetchpriority="high" />
        <img src="/brand/illus-light.webp" alt="" class="l" width="668" height="590" aria-hidden="true" />
      </figure>
    </div>

    <div class="wrap">
      <div class="stats">
        {c.stats.map((s: any) => (
          <div class="stat reveal">
            <strong class="dsp">{s.n}</strong>
            <span>{s.l}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ LAYANAN ============ -->
  <section class="sect" id="layanan">
    <div class="wrap">
      <header class="shead">
        <div class="reveal">
          <span class="eyebrow">{c.layananEye}</span>
          <h2 class="h2">{c.layananH2}</h2>
        </div>
        <p class="lead reveal">{c.layananLead}</p>
      </header>

      <div class="grid g2">
        {c.services.map((s: any) => (
          <a href={s.href.startsWith('#') ? r() + s.href : r(s.href)} class="card reveal svc">
            <div class="ic">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={icons[s.ic]} />
            </div>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
            <div class="tags">{s.tags.map((x: string) => <span>{x}</span>)}</div>
            <span class="go" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={arrow} />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ CLOUD PC ============ -->
  <section class="sect band">
    <div class="wrap split">
      <div class="reveal">
        <span class="eyebrow">{c.cpEye}</span>
        <h2 class="h2">{c.cpH2}</h2>
        <p class="lead">{c.cpLead}</p>
        <ul class="checks">{c.cpChecks.map((x: string) => <li>{x}</li>)}</ul>
        <a href={r('cloud-pc')} class="btn btn-p" style="margin-top:30px">{c.cpBtn} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={arrow} /></a>
      </div>

      <div class="win reveal" role="img" aria-label={c.winAria}>
        <div class="wbar"><i></i><i></i><i></i><span>xyverse — remote session</span></div>
        <div class="wbody">
          <div class="row"><span class="k">Instance</span><span class="v">xy-creator-04</span></div>
          <div class="row"><span class="k">GPU</span><span class="v">NVIDIA · 6 GB</span></div>
          <div class="row"><span class="k">{c.winRows.cpu}</span><span class="v">8 · 24 GB</span></div>
          <div class="row"><span class="k">Region</span><span class="v">Singapore</span></div>
          <div class="row"><span class="k">{c.winRows.lat}</span><span class="v ok">18 ms</span></div>
          <div class="meter"><div class="fill"></div></div>
          <div class="row"><span class="k">{c.winRows.status}</span><span class="v ok"><i class="dot"></i> {c.winRows.running}</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PROSES ============ -->
  <section class="sect" id="proses">
    <div class="wrap">
      <header class="shead">
        <div class="reveal">
          <span class="eyebrow">{c.prosesEye}</span>
          <h2 class="h2">{c.prosesH2}</h2>
        </div>
        <p class="lead reveal">{c.prosesLead}</p>
      </header>
      <div class="grid g4">
        {c.steps.map((s: any) => (
          <div class="card reveal step">
            <span class="num dsp">{s.n}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ PROYEK ============ -->
  <section class="sect band">
    <div class="wrap">
      <header class="shead">
        <div class="reveal">
          <span class="eyebrow">{c.proyekEye}</span>
          <h2 class="h2">{c.proyekH2}</h2>
        </div>
        <p class="lead reveal">
          {c.proyekLeadA}<a href={r('proyek')} class="ln">{c.proyekLink}</a>
        </p>
      </header>
      <div class="grid g2">
        {proyekTop.map((p) => (
          <a href={r(`proyek/${slugKonten(p.id)}`)} class="card reveal pcard">
            <div class="ptop">
              <span class="ptag">{p.data.layanan}</span>
              <span class="pst">{p.data.status}</span>
            </div>
            <h3>{p.data.title}</h3>
            <p>{p.data.desc}</p>
            <div class="pstack">{p.data.stack.slice(0, 4).map((t) => <span>{t}</span>)}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ BLOG ============ -->
  <section class="sect">
    <div class="wrap">
      <header class="shead">
        <div class="reveal">
          <span class="eyebrow">{c.blogEye}</span>
          <h2 class="h2">{c.blogH2}</h2>
        </div>
        <p class="lead reveal">
          {c.blogLeadA}<a href={r('blog')} class="ln">{c.blogLink}</a>
        </p>
      </header>
      <div class="grid g3">
        {blogTop.map((b) => (
          <a href={r(`blog/${slugKonten(b.id)}`)} class="card reveal bcard">
            <span class="ptag">{b.data.kategori}</span>
            <h3>{b.data.title}</h3>
            <p>{b.data.desc}</p>
            <div class="bfoot">
              <time datetime={b.data.date.toISOString()}>{fmtD(b.data.date)}</time>
              <span>{b.data.baca} {c.menit}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ TENTANG ============ -->
  <section class="sect" id="tentang">
    <div class="wrap about">
      <div class="reveal">
        <span class="eyebrow">{c.ttgEye}</span>
        <h2 class="h2">{c.ttgH2}</h2>
        <a href={r('harga')} class="btn btn-g" style="margin-top:22px">{c.ttgBtn}</a>
      </div>
      <div class="reveal atxt">
        <p>{c.ttgP1}</p>
        <p>
          {c.ttgP2a}<strong>{c.ttgP2b}</strong>, <strong>{c.ttgP2c}</strong>, {lang === 'id' ? 'dan' : 'and'}
          <strong>{c.ttgP2d}</strong>{c.ttgP2e}
        </p>
      </div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="sect band" id="faq">
    <div class="wrap faq-l">
      <div class="reveal fsticky">
        <span class="eyebrow">{c.faqEye}</span>
        <h2 class="h2">{c.faqH2}</h2>
        <p class="lead">{c.faqLeadA}<a href="mailto:halo@xyverse.my.id" class="lnk">{c.faqLeadLink}</a>.</p>
      </div>
      <div class="faqs">
        {c.faqs.map((f: any) => (
          <details class="reveal">
            <summary>{f.q}<i></i></summary>
            <div class="ans"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ KONTAK ============ -->
  <section class="sect" id="kontak">
    <div class="wrap">
      <div class="cbox reveal">
        <div class="cinfo">
          <span class="eyebrow">{c.kontakEye}</span>
          <h2 class="h2">{c.kontakH2}</h2>
          <p class="lead">{c.kontakLead}</p>
          <a href="mailto:halo@xyverse.my.id" class="cmail">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/></svg>
            <div><span>{c.lEmail}</span><strong>halo@xyverse.my.id</strong></div>
          </a>
          <a href={r('kontak')} class="cmail">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <div><span>{c.lKantor}</span><strong>{c.lKantorV}</strong></div>
          </a>
          <a href="https://wa.me/6281234567890" target="_blank" rel="noopener" class="cmail">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-12.6 7.3L3 20.5l1.8-5.3A8.4 8.4 0 1 1 21 11.5z"/></svg>
            <div><span>{c.lWa}</span><strong>+62 812-3456-7890</strong></div>
          </a>
        </div>

        {/*
          Dulu: action="mailto:" + <select> native. Mailto membuka aplikasi
          email pengguna dan sering gagal tanpa pesan; select native tampil
          beda di tiap OS dan tidak bisa diberi gaya.
        */}
        <form class="cf" id="cf" novalidate data-api={URL_PESAN} data-err-umum={c.errUmum}>
          <Pesan tipe="err" id="cf-err" sembunyi>{c.errUmum}</Pesan>
          <Pesan tipe="ok" id="cf-ok" sembunyi>{c.fOk}</Pesan>

          <div class="frow">
            <div class="f" data-f="nama">
              <label class="f-lb" for="b-nama">{c.fNama}</label>
              <input class="inp" id="b-nama" type="text" name="nama" placeholder={c.fNamaPh} required autocomplete="name" />
              <span class="f-msg" data-msg hidden><Ikon n="bahaya" />{c.errNama}</span>
            </div>
            <div class="f" data-f="email">
              <label class="f-lb" for="b-email">{c.fEmail}</label>
              <input class="inp" id="b-email" type="email" name="email" placeholder="nama@email.com" required autocomplete="email" />
              <span class="f-msg" data-msg hidden><Ikon n="bahaya" />{c.errEmail}</span>
            </div>
          </div>

          <div class="f">
            <span class="f-lb">{c.fKebutuhan}</span>
            <Pilih nama="topik" label={c.fKebutuhan} opsi={c.fOpsi.map((o: string) => ({ v: o, t: o }))} />
          </div>

          <div class="f" data-f="pesan">
            <label class="f-lb" for="b-pesan">{c.fPesan}</label>
            <textarea class="ta" id="b-pesan" name="pesan" rows="4" placeholder={c.fPesanPh} required></textarea>
            <span class="f-msg" data-msg hidden><Ikon n="bahaya" />{c.errPesan}</span>
          </div>

          {/* Honeypot: tidak terlihat manusia, diisi bot. */}
          <div class="hp" aria-hidden="true">
            <label for="b-situs">{c.fSitus}</label>
            <input id="b-situs" type="text" name={HONEYPOT} tabindex="-1" autocomplete="off" />
          </div>

          <button type="submit" class="btn btn-p" id="cf-kirim" data-teks={c.fKirim}>{c.fKirim}</button>
          <script type="application/json" id="cf-teks" set:html={JSON.stringify({
            jaringan: c.errJaringan, terlaluSering: c.errTerlaluSering, gagal: c.errKirim,
          })} />
        </form>
      </div>
    </div>
  </section>
</Base>

<style>
/* ---------- HERO ---------- */
.hero{padding:74px 0 0;position:relative;overflow:hidden}
.hero::before{
  content:'';position:absolute;inset:0;pointer-events:none;
  background:radial-gradient(ellipse 60% 44% at 22% 8%,var(--glow),transparent 70%);
}
.hero-in{position:relative;z-index:2;display:grid;grid-template-columns:1fr 1.05fr;gap:52px;align-items:center}
.pill{
  display:inline-flex;align-items:center;gap:9px;padding:7px 15px;border-radius:999px;
  font-size:12.5px;font-weight:500;color:var(--txt-2);margin-bottom:24px;
  background:var(--card);border:1px solid var(--line);
}
.pill i{width:6px;height:6px;border-radius:50%;background:#34d399;box-shadow:0 0 0 3px rgba(52,211,153,.18)}
h1{font-size:clamp(34px,5.6vw,58px);margin-bottom:20px;max-width:15ch}
h1 em{font-style:normal;color:var(--brand)}
.hero .lead strong{color:var(--txt);font-weight:600}
.cta-row{display:flex;gap:12px;flex-wrap:wrap;margin-top:32px}
.micro{margin-top:26px;font-size:13px;color:var(--txt-2);opacity:.85}
.hero-art{position:relative;display:grid;place-items:center}
.hero-art::before{
  content:'';position:absolute;width:82%;aspect-ratio:1;border-radius:50%;
  background:radial-gradient(circle,var(--glow),transparent 66%);filter:blur(14px);
}
.hero-art img{width:100%;height:auto;position:relative;z-index:2;animation:drift 8s ease-in-out infinite}
@keyframes drift{0%,100%{transform:translateY(0)}50%{}}
@media(prefers-reduced-motion:reduce){.hero-art img{animation:none}}
html[data-theme='dark'] .hero-art .l{display:none}
html[data-theme='light'] .hero-art .d{display:none}
@media(max-width:940px){
  .hero-in{grid-template-columns:1fr;gap:38px}
  .hero-art{order:-1}
  h1{max-width:none}
}
.stats{
  display:grid;grid-template-columns:repeat(4,1fr);gap:24px;
  margin-top:72px;padding:30px 0 0;border-top:1px solid var(--line);position:relative;z-index:2;
}
.stat strong{display:block;font-size:clamp(25px,3.2vw,34px);color:var(--txt);margin-bottom:2px}
.stat span{color:var(--txt-2);font-size:13.5px;line-height:1.45;display:block}
@media(max-width:700px){.stats{grid-template-columns:1fr 1fr;gap:22px;margin-top:52px}}

.band{background:var(--bg-2);border-block:1px solid var(--line)}

/* ---------- SECTION HEADER ---------- */
.shead{display:grid;grid-template-columns:1fr 1fr;gap:34px;align-items:end;margin-bottom:44px}
@media(max-width:820px){.shead{grid-template-columns:1fr;gap:14px;margin-bottom:34px}}

/* ---------- SERVICES ---------- */
.svc{display:block;padding-bottom:30px}
.svc .ic{
  width:46px;height:46px;border-radius:8px;display:grid;place-items:center;margin-bottom:18px;
  background:color-mix(in srgb,var(--pur) 14%,transparent);color:var(--brand);
  border:1px solid color-mix(in srgb,var(--pur) 26%,transparent);transition:.25s var(--ease);
}
.svc:hover .ic{background:var(--pur);color:#fff}
.svc .ic svg{width:22px;height:22px}
.svc h3{font-size:19.5px;margin-bottom:9px}
.svc p{color:var(--txt-2);font-size:14.8px;max-width:44ch}
.tags{display:flex;gap:7px;flex-wrap:wrap;margin-top:18px}
.tags span{
  font-size:11.5px;font-weight:500;padding:5px 11px;border-radius:7px;
  background:var(--surface);border:1px solid var(--line);color:var(--txt-2);
}
.go{
  position:absolute;right:22px;bottom:22px;width:32px;height:32px;border-radius:6px;
  display:grid;place-items:center;color:var(--brand);opacity:0;transform:translateX(-6px);
  transition:.25s var(--ease);background:color-mix(in srgb,var(--pur) 12%,transparent);
}
.go svg{width:16px;height:16px}
.svc:hover .go{opacity:1;transform:none}

/* ---------- SPLIT / WINDOW ---------- */
.split{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center}
@media(max-width:940px){.split{grid-template-columns:1fr;gap:40px}}
.checks{list-style:none;margin-top:26px;display:grid;gap:13px}
.checks li{padding-left:31px;position:relative;color:var(--txt-2);font-size:15px}
.checks li::before{
  content:'✓';position:absolute;left:0;top:1px;width:21px;height:21px;border-radius:7px;
  background:color-mix(in srgb,var(--pur) 15%,transparent);color:var(--brand);
  display:grid;place-items:center;font-size:11.5px;font-weight:700;
}
.win{border:1px solid var(--line);border-radius:var(--r);overflow:hidden;background:var(--card);box-shadow:var(--shadow)}
.wbar{display:flex;align-items:center;gap:7px;padding:13px 16px;background:var(--surface);border-bottom:1px solid var(--line)}
.wbar i{width:10px;height:10px;border-radius:50%;background:var(--line)}
.wbar i:nth-child(1){background:#f87171}.wbar i:nth-child(2){background:#fbbf24}.wbar i:nth-child(3){background:#34d399}
.wbar span{margin-left:8px;font-size:12px;color:var(--txt-2);font-family:ui-monospace,SFMono-Regular,monospace}
.wbody{padding:8px 22px 22px}
.row{display:flex;justify-content:space-between;align-items:center;padding:11px 0;border-bottom:1px solid var(--line);font-size:14px}
.row:last-child{border:0;padding-bottom:0}
.k{color:var(--txt-2)}
.v{font-family:ui-monospace,SFMono-Regular,monospace;font-size:13.5px}
.v.ok{color:#10b981;display:inline-flex;align-items:center;gap:7px}
.dot{width:7px;height:7px;border-radius:50%;background:#10b981;animation:blink 2s ease-in-out infinite}
@keyframes blink{50%{opacity:.35}}
.meter{height:6px;border-radius:99px;background:var(--surface);margin:16px 0 4px;overflow:hidden;border:1px solid var(--line)}
.fill{height:100%;border-radius:99px;background:linear-gradient(90deg,var(--pur-d),var(--pur-l));animation:load 3.4s ease-in-out infinite alternate}
@keyframes load{from{width:42%}to{width:86%}}

/* ---------- STEPS ---------- */
.step .num{display:block;font-size:12.5px;font-weight:700;color:var(--brand);letter-spacing:.14em;margin-bottom:14px}
.step h3{font-size:17.5px;margin-bottom:8px}
.step p{color:var(--txt-2);font-size:14.5px}

/* ---------- ABOUT ---------- */
.about{display:grid;grid-template-columns:.85fr 1.15fr;gap:54px}
.atxt p{color:var(--txt-2);font-size:16.5px;line-height:1.75}
.atxt p+p{margin-top:16px}
.atxt strong{color:var(--txt);font-weight:600}
@media(max-width:900px){.about{grid-template-columns:1fr;gap:26px}}

/* ---------- FAQ ---------- */
.faq-l{display:grid;grid-template-columns:.8fr 1.2fr;gap:54px;align-items:start}
.fsticky{position:sticky;top:110px}
@media(max-width:900px){.faq-l{grid-template-columns:1fr;gap:30px}.fsticky{position:static}}
.lnk{color:var(--brand);font-weight:600;border-bottom:1px solid currentColor}
.faqs{display:grid;gap:10px}
details{border:1px solid var(--line);border-radius:8px;background:var(--card);overflow:hidden;transition:border-color .25s}
details[open]{border-color:var(--line-s)}
summary{
  list-style:none;cursor:pointer;padding:19px 22px;font-weight:600;font-size:15.5px;
  display:flex;justify-content:space-between;align-items:center;gap:18px;
}
summary::-webkit-details-marker{display:none}
summary:hover{color:var(--brand)}
summary i{
  width:10px;height:10px;border-right:2px solid var(--brand);border-bottom:2px solid var(--brand);
  transform:rotate(45deg) translateY(-2px);transition:.25s var(--ease);flex:none;
}
details[open] summary i{transform:rotate(-135deg) translateY(-2px)}
.ans{padding:0 22px 20px}
.ans p{color:var(--txt-2);font-size:15px;max-width:62ch}

/* ---------- CARDS: PROYEK & BLOG ---------- */
.ln{color:var(--brand);font-weight:600;white-space:nowrap}
.ln:hover{text-decoration:underline}
.pcard,.bcard{display:flex;flex-direction:column}
.ptop{display:flex;justify-content:space-between;gap:10px;align-items:center;margin-bottom:13px}
.ptag{
  display:inline-block;font-size:11.5px;font-weight:600;padding:4px 10px;border-radius:6px;
  background:color-mix(in srgb,var(--pur) 14%,transparent);
  border:1px solid color-mix(in srgb,var(--pur) 28%,transparent);color:var(--brand);
}
.pst{font-size:11.5px;font-weight:600;padding:4px 10px;border-radius:6px;border:1px solid var(--line);color:var(--txt-2)}
.pcard h3,.bcard h3{font-size:19px;margin:0 0 9px;line-height:1.3}
.bcard h3{margin-top:13px}
.pcard p,.bcard p{color:var(--txt-2);font-size:14.5px;flex:1}
.pstack{display:flex;gap:7px;flex-wrap:wrap;margin-top:18px}
.pstack span{font-size:11.5px;padding:4px 10px;border-radius:6px;background:var(--surface);border:1px solid var(--line);color:var(--txt-2)}
.bfoot{display:flex;justify-content:space-between;margin-top:18px;padding-top:14px;border-top:1px solid var(--line);font-size:12.5px;color:var(--txt-2)}

/* ---------- CONTACT ---------- */
.cbox{
  display:grid;grid-template-columns:1fr 1.1fr;gap:48px;
  border:1px solid var(--line);border-radius:8px;padding:44px;
  background:var(--card);box-shadow:var(--shadow);position:relative;overflow:hidden;
}
.cbox::before{content:'';position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse 50% 60% at 100% 0%,var(--glow),transparent 70%)}
.cbox>*{position:relative;z-index:2}
@media(max-width:900px){.cbox{grid-template-columns:1fr;gap:34px;padding:30px 24px}}
.cmail{display:flex;align-items:center;gap:14px;margin-top:18px;padding:14px 16px;border-radius:8px;border:1px solid var(--line);background:var(--surface);transition:.22s var(--ease)}
.cmail:hover{border-color:var(--line-s);}
.cmail svg{width:21px;height:21px;color:var(--brand);flex:none}
.cmail span{display:block;font-size:11.5px;text-transform:uppercase;letter-spacing:.1em;color:var(--txt-2)}
.cmail strong{font-size:15px;font-weight:600}
.cf{display:grid;gap:15px;align-content:start}
.frow{display:grid;grid-template-columns:1fr 1fr;gap:15px}
@media(max-width:620px){.frow{grid-template-columns:1fr}}
/* Honeypot: keluar dari aliran, tetap ada di DOM untuk bot. */
.hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
.f{display:grid;gap:6px}
.f-lb{font-size:13.2px;font-weight:600;color:var(--txt)}
.inp,.ta{
  width:100%;padding:11px 13px;border-radius:var(--rb);font:inherit;font-size:14.5px;
  background:var(--surface);border:1px solid var(--line);color:var(--txt);
  transition:border-color .16s ease,box-shadow .16s ease;
}
.ta{resize:vertical;min-height:96px;line-height:1.6}
.inp:focus,.ta:focus{outline:0;border-color:var(--pur);box-shadow:0 0 0 3px color-mix(in srgb,var(--pur) 15%,transparent)}
.f.is-err .inp,.f.is-err .ta{border-color:#ef4444}
.f-msg{display:flex;align-items:center;gap:6px;font-size:12.8px;color:#f87171}
.f-msg svg{width:14px;height:14px;flex:none}
.cf .dd,.cf .dd-btn{width:100%}
@media(max-width:560px){.frow{grid-template-columns:1fr}}
.cf label{display:grid;gap:7px;font-size:13px;font-weight:600;color:var(--txt-2)}
.cf input,.cf select,.cf textarea{
  width:100%;padding:12px 15px;border-radius:7px;border:1px solid var(--line);
  background:var(--bg);color:var(--txt);font:inherit;font-size:14.8px;font-weight:400;
  outline:none;transition:.2s;
}
.cf input::placeholder,.cf textarea::placeholder{color:var(--txt-2);opacity:.65}
.cf input:focus,.cf select:focus,.cf textarea:focus{border-color:var(--pur);box-shadow:0 0 0 3px var(--glow)}
.cf textarea{resize:vertical;min-height:100px}
.cf button{margin-top:4px}
.ok{color:#10b981;font-size:14px;font-weight:500;text-align:center}
</style>

<script>
  const f = document.getElementById('cf') as HTMLFormElement | null;
  f?.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = new FormData(f);
    const body = `Nama: ${d.get('nama')}\nEmail: ${d.get('email')}\nKebutuhan: ${d.get('topik')}\n\n${d.get('pesan')}`;
    window.location.href = `mailto:halo@xyverse.my.id?subject=${encodeURIComponent('Permintaan: ' + d.get('topik'))}&body=${encodeURIComponent(body)}`;
    const ok = document.getElementById('ok');
    if (ok) ok.hidden = false;
  });
</script>

<script is:inline>
  /*
   * Form kontak beranda.
   *
   * Validasi di klien hanya untuk kenyamanan — server mengulang semuanya.
   * Yang penting di sini: kegagalan TIDAK dilaporkan sebagai keberhasilan.
   * Versi lama menampilkan "✓ Terima kasih" apa pun yang terjadi.
   */
  (function () {
    var f = document.getElementById('cf');
    if (!f) return;
    var btn = document.getElementById('cf-kirim');
    var boxErr = document.getElementById('cf-err');
    var boxOk = document.getElementById('cf-ok');
    var TEKS = JSON.parse((document.getElementById('cf-teks') || {}).textContent || '{}');
    var URL_API = f.dataset.api;

    var aturan = {
      nama: function (v) { return v.trim().length >= 2; },
      email: function (v) { return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.trim()); },
      pesan: function (v) { return v.trim().length >= 10; }
    };

    function nilai(nama) {
      var el = f.querySelector('[name="' + nama + '"]');
      var kotak = f.querySelector('[data-f="' + nama + '"]');
      var lulus = aturan[nama](String((el && el.value) || ''));
      if (kotak) {
        kotak.classList.toggle('is-err', !lulus);
        var msg = kotak.querySelector('[data-msg]');
        if (msg) msg.hidden = lulus;
      }
      return lulus;
    }

    Object.keys(aturan).forEach(function (nama) {
      var el = f.querySelector('[name="' + nama + '"]');
      if (el) el.addEventListener('blur', function () { nilai(nama); });
    });

    f.addEventListener('submit', function (e) {
      e.preventDefault();
      if (boxOk) boxOk.hidden = true;

      var lulus = Object.keys(aturan).map(nilai);
      if (lulus.indexOf(false) !== -1) {
        if (boxErr) { boxErr.textContent = f.dataset.errUmum || ''; boxErr.hidden = false; }
        var salah = f.querySelector('.is-err .inp,.is-err .ta');
        if (salah) salah.focus();
        return;
      }
      if (boxErr) boxErr.hidden = true;

      btn.classList.add('is-load');
      btn.disabled = true;

      var isi = {};
      new FormData(f).forEach(function (v, k) { if (typeof v === 'string') isi[k] = v; });

      fetch(URL_API, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(isi)
      })
        .then(function (r) {
          return r.json().catch(function () { return {}; }).then(function (d) { return { status: r.status, d: d }; });
        })
        .then(function (x) {
          btn.classList.remove('is-load');
          btn.disabled = false;
          if (x.status === 429) return galat(TEKS.terlaluSering);
          if (x.status < 200 || x.status >= 300) return galat(x.d.error || TEKS.gagal);
          if (boxOk) { boxOk.hidden = false; boxOk.scrollIntoView({ block: 'nearest' }); }
          f.reset();
        })
        .catch(function () {
          btn.classList.remove('is-load');
          btn.disabled = false;
          galat(TEKS.jaringan);
        });

      function galat(teks) {
        if (!boxErr) return;
        boxErr.textContent = teks;
        boxErr.hidden = false;
        boxErr.scrollIntoView({ block: 'nearest' });
      }
    });
  })();
</script>
