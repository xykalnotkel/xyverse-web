---
import { jalurBahasa, rute } from '../../i18n/config';
import { pakaiT } from '../../i18n/ui';
import { KARIER } from '../../i18n/halaman/karier';
import { NILAI_TEKS } from '../../i18n/data';

export function getStaticPaths() { return jalurBahasa(); }

const { lang } = Astro.props;
const t = pakaiT(lang);
const r = (p = '') => rute(lang, p);
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { SITE } from '../../data/site';

const c = KARIER[lang];
const NILAI = NILAI_TEKS[lang];

const IK = {
  globe: '<circle cx="12" cy="12" r="9.2"/><path d="M2.8 12h18.4M12 2.8a15 15 0 0 1 0 18.4 15 15 0 0 1 0-18.4"/>',
  clock: '<circle cx="12" cy="12" r="9.2"/><path d="M12 6.8V12l3.4 2"/>',
  laptop: '<rect x="3.5" y="4.5" width="17" height="11" rx="2"/><path d="M1.5 19h21"/>',
  book: '<path d="M4 4.5A2 2 0 0 1 6 2.5h13v17H6a2 2 0 0 0-2 2z"/><path d="M4 19.5a2 2 0 0 1 2-2h13"/>',
  sun: '<circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.4M12 19.1v2.4M4.2 4.2l1.7 1.7M18.1 18.1l1.7 1.7M2.5 12h2.4M19.1 12h2.4M4.2 19.8l1.7-1.7M18.1 5.9l1.7-1.7"/>',
  chart: '<path d="M3 20.5h18M6.5 17V11M11 17V5.5M15.5 17v-8M20 17v-4"/>',
};

const ld = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: c.metaTitle,
  url: `${SITE.url}/karier`,
  description: c.ldDesc,
};
---

<Base
  lang={lang}
  title={`${c.metaTitle} — ${SITE.nama}`}
  desc={c.metaDesc}
  ogTag={c.ogTag}
  jsonld={ld}
>
  <PageHead
    eyebrow={c.eyebrow}
    title={c.judul}
    lead={c.lead}
  />

  <section class="sect" style="padding-top:40px">
    <div class="wrap">
      <h2 class="st">{c.h2low} <span class="jml">{c.lowongan.length}</span></h2>
      <div class="lows">
        {c.lowongan.map((l: any) => (
          <article class="lc reveal">
            <div class="lhd">
              <div>
                <h3>{l.t}</h3>
                <div class="meta">
                  <span class="mt">{l.tim}</span>
                  <span class="mt">{l.tipe}</span>
                  <span class="mt">{l.lok}</span>
                </div>
              </div>
              <a href={r('kontak')} class="btn btn-g btn-sm">{c.lamar}</a>
            </div>
            <p>{l.d}</p>
            <div class="skill">{l.skill.map((s: string) => <span>{s}</span>)}</div>
          </article>
        ))}
      </div>

      <h2 class="st mt">{c.h2mag}</h2>
      <div class="grid g2">
        {c.magang.map((m: any) => (
          <div class="mc reveal">
            <div class="mhd"><strong>{m.t}</strong><span class="dur">{m.durasi}</span></div>
            <p>{m.d}</p>
            <a href={r('kontak')} class="go">{c.daftarMagang}</a>
          </div>
        ))}
      </div>

      <h2 class="st mt">{c.h2unt}</h2>
      <div class="grid g3">
        {c.untung.map((u: any) => (
          <div class="uc reveal">
            <span class="uik">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={IK[u.ik]} />
            </span>
            <strong>{u.t}</strong>
            <small>{u.d}</small>
          </div>
        ))}
      </div>

      <h2 class="st mt">{c.h2pro}</h2>
      <ol class="pros reveal">
        {c.proses.map((p: any) => (
          <li>
            <span class="num">{p.n}</span>
            <div><strong>{p.t}</strong><p>{p.d}</p></div>
          </li>
        ))}
      </ol>

      <div class="nilai reveal">
        <h2 class="st">{c.h2nilai}</h2>
        <div class="grid g2">
          {NILAI.map((n) => (
            <div class="nc"><strong>{n.t}</strong><small>{n.d}</small></div>
          ))}
        </div>
      </div>

      <div class="cta reveal">
        <h2>{c.ctaH2}</h2>
        <p>{c.ctaP}</p>
        <div class="act">
          <a href={r('kontak')} class="btn btn-p">{c.ctaB1}</a>
          <a href={r('tentang')} class="btn btn-g">{c.ctaB2}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
.st{font-size:23px;margin-bottom:20px;display:flex;align-items:center;gap:10px}
.mt{margin-top:46px}
.jml{font-size:11.5px;font-weight:700;padding:2px 9px;border-radius:999px;
  background:var(--pur);color:#fff}
.lows{display:grid;gap:12px}
.lc{border:1px solid var(--line);border-radius:12px;padding:22px;background:var(--card);
  box-shadow:var(--shadow);transition:border-color .16s ease,box-shadow .16s ease}
.lc:hover{border-color:var(--line-s);box-shadow:var(--shadow-h)}
.lhd{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;margin-bottom:11px;flex-wrap:wrap}
.lc h3{font-size:17px;margin-bottom:7px}
.meta{display:flex;gap:7px;flex-wrap:wrap}
.meta .mt{margin:0;font-size:11.5px;font-weight:600;padding:3px 9px;border-radius:5px;
  background:var(--surface);border:1px solid var(--line);color:var(--txt-2)}
.lc p{font-size:14px;color:var(--txt-2);line-height:1.65;margin-bottom:13px;max-width:70ch}
.skill{display:flex;gap:6px;flex-wrap:wrap}
.skill span{font-size:11.5px;padding:3px 9px;border-radius:5px;
  background:color-mix(in srgb,var(--pur) 10%,transparent);
  border:1px solid color-mix(in srgb,var(--pur) 24%,transparent);color:var(--brand)}

.mc{border:1px solid var(--line);border-radius:12px;padding:21px;background:var(--card);box-shadow:var(--shadow)}
.mhd{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:8px}
.mhd strong{font-size:16px}
.dur{font-size:11.5px;font-weight:600;padding:3px 9px;border-radius:5px;
  background:var(--surface);border:1px solid var(--line);color:var(--txt-2);white-space:nowrap}
.mc p{font-size:13.8px;color:var(--txt-2);line-height:1.65;margin-bottom:12px}
.go{font-size:13.3px;font-weight:600;color:var(--brand)}

.uc{border:1px solid var(--line);border-radius:12px;padding:20px;background:var(--card);box-shadow:var(--shadow)}
.uik{width:36px;height:36px;border-radius:8px;display:grid;place-items:center;margin-bottom:12px;
  background:var(--surface);border:1px solid var(--line);color:var(--brand)}
.uik svg{width:17px;height:17px}
.uc strong{display:block;font-size:15px;margin-bottom:5px}
.uc small{font-size:13.4px;color:var(--txt-2);line-height:1.6}

.pros{list-style:none;padding:0;display:grid;gap:14px;max-width:72ch}
.pros li{display:flex;gap:15px}
.num{font-size:12px;font-weight:800;color:var(--brand);flex:none;
  width:34px;height:34px;border-radius:8px;display:grid;place-items:center;
  background:var(--surface);border:1px solid var(--line)}
.pros strong{display:block;font-size:15.3px;margin-bottom:3px}
.pros p{font-size:13.8px;color:var(--txt-2);line-height:1.6}

.nilai{margin-top:46px}
.nc{border:1px solid var(--line);border-radius:10px;padding:19px;background:var(--surface)}
.nc strong{display:block;font-size:15px;margin-bottom:5px;color:var(--brand)}
.nc small{font-size:13.5px;color:var(--txt-2);line-height:1.62}

.cta{margin-top:46px;border:1px solid var(--line);border-radius:12px;padding:34px;
  background:var(--card);text-align:center;box-shadow:var(--shadow)}
.cta h2{font-size:21px;margin-bottom:9px}
.cta p{color:var(--txt-2);font-size:15px;max-width:58ch;margin:0 auto 20px}
.cta .act{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
</style>
