---
import { jalurBahasa, rute } from '../../i18n/config';
import { pakaiT } from '../../i18n/ui';
import { KOMUNITAS } from '../../i18n/halaman/komunitas';

export function getStaticPaths() { return jalurBahasa(); }

const { lang } = Astro.props;
const t = pakaiT(lang);
const r = (p = '') => rute(lang, p);
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import SosmedIkon from '../../components/SosmedIkon.astro';
import { SITE, SOSMED } from '../../data/site';

const c = KOMUNITAS[lang];
const urlSos = (ik: string) => SOSMED.find((x) => x.ikon === ik)?.url || '#';
const kanal = c.kanal.map((k: any) => ({ ...k, url: urlSos(k.ik) }));

const IKK = {
  mic: '<rect x="9" y="2.5" width="6" height="11" rx="3"/><path d="M5.5 11.5a6.5 6.5 0 0 0 13 0M12 18v3.5M8.5 21.5h7"/>',
  monitor: '<rect x="2.5" y="3.5" width="19" height="13" rx="2"/><path d="M8.5 20.5h7M12 16.5v4"/>',
  cap: '<path d="M12 3 2 8l10 5 10-5z"/><path d="M6 10.5V16c0 1.7 2.7 3 6 3s6-1.3 6-3v-5.5"/>',
  trophy: '<path d="M7 4h10v6a5 5 0 0 1-10 0z"/><path d="M7 6H4.5v2A3.5 3.5 0 0 0 8 11.5M17 6h2.5v2a3.5 3.5 0 0 1-3.5 3.5M9 20h6M12 15v5"/>',
};

const ld = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: c.metaTitle,
  url: `${SITE.url}/komunitas`,
  description: c.ldDesc,
};
---

<Base
  lang={lang}
  title={`${c.metaTitle} — ${SITE.nama}`}
  desc={c.metaDesc}
  ogTag={c.ogTag}
  jsonld={ld}
>
  <PageHead
    eyebrow={c.eyebrow}
    title={c.judul}
    lead={c.lead}
  />

  <section class="sect" style="padding-top:40px">
    <div class="wrap">
      <h2 class="st">{c.h2kanal}</h2>
      <div class="grid g2">
        {kanal.map((k: any) => (
          <a href={k.url} target="_blank" rel="noopener noreferrer" class="kc reveal">
            <span class="kik"><SosmedIkon nama={k.ik} /></span>
            <div class="ktx">
              <div class="khd"><strong>{k.n}</strong><span class="tag">{k.anggota}</span></div>
              <small>{k.d}</small>
            </div>
            <span class="go">→</span>
          </a>
        ))}
      </div>

      <h2 class="st mt">{c.h2keg}</h2>
      <div class="grid g2">
        {c.kegiatan.map((g: any) => (
          <div class="gc reveal">
            <span class="gik">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={IKK[g.ik]} />
            </span>
            <div>
              <strong>{g.t}</strong>
              <p>{g.d}</p>
              <span class="jdw">{g.jadwal}</span>
            </div>
          </div>
        ))}
      </div>

      <div class="dua">
        <div class="reveal">
          <h2 class="st">{c.h2aturan}</h2>
          <ul class="atur">
            {c.aturan.map((a: string) => (
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                <span>{a}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="reveal">
          <h2 class="st">{c.h2sos}</h2>
          <div class="sos">
            {SOSMED.map((s) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="sc">
                <SosmedIkon nama={s.ikon} />
                <div><strong>{s.nama}</strong><small>{s.handle}</small></div>
              </a>
            ))}
          </div>
        </div>
      </div>

      <div class="cta reveal">
        <h2>{c.ctaH2}</h2>
        <p>{c.ctaP}</p>
        <div class="act">
          <a href={SOSMED.find(s=>s.ikon==='discord')?.url} target="_blank" rel="noopener noreferrer" class="btn btn-p">{c.ctaB1}</a>
          <a href={r('kontribusi')} class="btn btn-g">{c.ctaB2}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
.st{font-size:23px;margin-bottom:20px}
.mt{margin-top:44px}
.kc{
  display:flex;align-items:center;gap:15px;border:1px solid var(--line);border-radius:12px;
  padding:19px 21px;background:var(--card);box-shadow:var(--shadow);
  transition:border-color .16s ease,box-shadow .16s ease,background .16s ease;
}
.kc:hover{border-color:var(--line-s);box-shadow:var(--shadow-h);background:var(--card-h)}
.kik{
  width:42px;height:42px;border-radius:9px;display:grid;place-items:center;flex:none;
  background:var(--surface);border:1px solid var(--line);color:var(--brand);
  transition:background .16s ease,color .16s ease,border-color .16s ease;
}
.kc:hover .kik{background:var(--pur);color:#fff;border-color:var(--pur)}
.kik :global(svg){width:19px;height:19px}
.ktx{flex:1}
.khd{display:flex;align-items:center;gap:9px;margin-bottom:3px}
.khd strong{font-size:15.5px}
.tag{font-size:10.5px;font-weight:700;padding:2px 8px;border-radius:999px;
  background:var(--surface);border:1px solid var(--line);color:var(--txt-2)}
.ktx small{font-size:13.3px;color:var(--txt-2);line-height:1.55}
.kc .go{color:var(--brand);font-size:18px;flex:none}

.gc{display:flex;gap:14px;border:1px solid var(--line);border-radius:12px;padding:20px;
  background:var(--card);box-shadow:var(--shadow)}
.gik{width:38px;height:38px;border-radius:8px;display:grid;place-items:center;flex:none;
  background:color-mix(in srgb,var(--pur) 12%,transparent);
  border:1px solid color-mix(in srgb,var(--pur) 28%,transparent);color:var(--brand)}
.gik svg{width:18px;height:18px}
.gc strong{display:block;font-size:15.5px;margin-bottom:5px}
.gc p{font-size:13.6px;color:var(--txt-2);line-height:1.6;margin-bottom:9px}
.jdw{font-size:11.5px;font-weight:600;padding:3px 9px;border-radius:5px;
  background:var(--surface);border:1px solid var(--line);color:var(--txt-2)}

.dua{display:grid;grid-template-columns:1fr 1fr;gap:44px;margin-top:48px;align-items:start}
@media(max-width:900px){.dua{grid-template-columns:1fr;gap:34px}}
.atur{list-style:none;padding:0;display:grid;gap:11px}
.atur li{display:flex;gap:10px;font-size:14px;color:var(--txt-2);line-height:1.62}
.atur svg{width:16px;height:16px;flex:none;margin-top:3px;color:#10b981}
.sos{display:grid;grid-template-columns:1fr 1fr;gap:9px}
@media(max-width:560px){.sos{grid-template-columns:1fr}}
.sc{display:flex;align-items:center;gap:11px;border:1px solid var(--line);border-radius:8px;
  padding:12px 14px;background:var(--card);box-shadow:var(--shadow);
  transition:border-color .16s ease,background .16s ease}
.sc:hover{border-color:var(--line-s);background:var(--card-h)}
.sc :global(svg){width:17px;height:17px;color:var(--brand);flex:none}
.sc strong{display:block;font-size:14px}
.sc small{font-size:12.2px;color:var(--txt-2)}

.cta{margin-top:48px;border:1px solid var(--line);border-radius:12px;padding:34px;
  background:var(--card);text-align:center;box-shadow:var(--shadow)}
.cta h2{font-size:21px;margin-bottom:9px}
.cta p{color:var(--txt-2);font-size:15px;max-width:56ch;margin:0 auto 20px}
.cta .act{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
</style>
