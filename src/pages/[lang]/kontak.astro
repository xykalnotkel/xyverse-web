---
import settings from '../../data/settings.json';
import { SITE } from '../../data/site';
import { jalurBahasa, rute } from '../../i18n/config';
import { pakaiT } from '../../i18n/ui';
import { KONTAK } from '../../i18n/halaman/kontak';

export function getStaticPaths() { return jalurBahasa(); }

const { lang } = Astro.props;
const t = pakaiT(lang);
const r = (p = '') => rute(lang, p);
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Pilih from '../../components/Pilih.astro';
import Pesan from '../../components/Pesan.astro';
import Ilustrasi from '../../components/Ilustrasi.astro';
import { HONEYPOT } from '../../lib/pesan';
import Ikon from '../../components/Ikon.astro';

const alamat = {
  jalan: 'Tanak Beaq, Kec. Batukliang Utara',
  kota: 'Kabupaten Lombok Tengah',
};
const c = KONTAK[lang];
const mapsQ = encodeURIComponent('Tanak Beaq, Batukliang Utara, Lombok Tengah, Nusa Tenggara Barat 83562');
---

<Base lang={lang} title={c.metaTitle} desc={c.metaDesc}>
  <PageHead
    eyebrow={c.eyebrow}
    title={c.judul}
    lead={c.lead}
  />

  <section class="sect" style="padding-top:44px">
    <div class="wrap layout">
      <div class="info">
        <Ilustrasi nama="hero-kontak" alt="" k="ilus-kontak" />
        <div class="ibox reveal">
          <div class="ic">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/></svg>
          </div>
          <div>
            <h3>{c.hEmail}</h3>
            <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
            <p>{c.pEmail}</p>
          </div>
        </div>

        {SITE.wa && (<div class="ibox reveal">
          <div class="ic">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-12.6 7.3L3 20.5l1.8-5.3A8.4 8.4 0 1 1 21 11.5z"/></svg>
          </div>
          <div>
            <h3>{c.hWa}</h3>
            <a href={`https://wa.me/${SITE.wa}`} target="_blank" rel="noopener">{SITE.waTampil}</a>
            <p>{c.pWa}</p>
          </div>
        </div>)}

        <div class="ibox reveal">
          <div class="ic">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div>
            <h3>{c.hKantor}</h3>
            <address>
              {alamat.jalan}<br />
              {alamat.kota}<br />
              {c.prov}<br />
              {c.negara}
            </address>
            <a href={`https://www.google.com/maps/search/?api=1&query=${mapsQ}`} target="_blank" rel="noopener" class="maps">{c.maps}</a>
          </div>
        </div>

        <div class="ibox reveal">
          <div class="ic">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          </div>
          <div>
            <h3>{c.hJam}</h3>
            <p class="hrs"><span>{c.jSenin}</span><strong>09.00 – 18.00</strong></p>
            <p class="hrs"><span>{c.jSabtu}</span><strong>09.00 – 14.00</strong></p>
            <p class="hrs"><span>{c.jMinggu}</span><strong>{c.jTutup}</strong></p>
            <p style="margin-top:8px">{c.jSupport}</p>
          </div>
        </div>
      </div>

      <form class="cf reveal" id="cf" novalidate data-min-pesan="20">
        <h2>{c.formH2}</h2>
        <p class="order-steps">{lang === 'id' ? '1. Kirim kebutuhan → 2. Tim konfirmasi stok & penawaran → 3. Sepakati pembayaran dan aktivasi. Mengisi form ini tidak langsung menagih pembayaran.' : '1. Send your requirements → 2. Our team confirms availability and a quote → 3. Agree on payment and activation. This form does not charge you.'}</p>
        <div class="f"><label class="f-lb" for="k-paket">{lang === 'id' ? 'Paket / layanan yang diminati' : 'Package / service of interest'}</label><input class="inp" id="k-paket" name="paket" list="paket-list" maxlength="120" placeholder={lang==='id'?'Opsional — pilih paket atau tulis kebutuhan':'Optional — choose a package or service'} /><datalist id="paket-list">{settings.plans.map(p=><option value={p.name}/>)}</datalist></div>

        <Pesan tipe="err" id="cf-err" sembunyi k="cf-top">{c.errUmum}</Pesan>
        <Pesan tipe="ok" id="cf-ok" judul={c.okJudul} sembunyi k="cf-top">{c.fOk}</Pesan>

        <div class="frow">
          <div class="f" data-f="nama">
            <label class="f-lb" for="k-nama">{c.fNama}</label>
            <input class="inp" id="k-nama" type="text" name="nama" placeholder={c.fNamaPh} required autocomplete="name" />
            <span class="f-msg" data-msg hidden><Ikon n="bahaya" />{c.errNama}</span>
          </div>
          <div class="f" data-f="email">
            <label class="f-lb" for="k-email">{c.fEmail}</label>
            <input class="inp" id="k-email" type="email" name="email" placeholder="nama@email.com" required autocomplete="email" />
            <span class="f-msg" data-msg hidden><Ikon n="bahaya" />{c.errEmail}</span>
          </div>
        </div>

        <div class="frow">
          <div class="f">
            <label class="f-lb" for="k-pt">{c.fPerusahaan} <span class="opt">{c.fOpsional}</span></label>
            <input class="inp" id="k-pt" type="text" name="perusahaan" placeholder={c.fPerusahaanPh} autocomplete="organization" />
          </div>
          <div class="f">
            <span class="f-lb">{c.fKebutuhan}</span>
            <Pilih nama="topik" label={c.fKebutuhan} opsi={c.opsiTopik.map((o: string) => ({ v: o, t: o }))} />
          </div>
        </div>

        <div class="f">
          <span class="f-lb">{c.fAnggaran} <span class="opt">{c.fOpsional}</span></span>
          <Pilih nama="budget" label={c.fAnggaran} opsi={c.opsiBudget.map((o: string) => ({ v: o, t: o }))} />
        </div>

        <div class="f" data-f="pesan">
          <label class="f-lb" for="k-pesan">{c.fPesan}</label>
          <textarea class="ta" id="k-pesan" name="pesan" rows="5" placeholder={c.fPesanPh} required></textarea>
          <span class="f-msg" data-msg hidden><Ikon n="bahaya" />{c.errPesan}</span>
        </div>

        {/*
          Honeypot. Manusia tidak pernah melihatnya (`.hp` disembunyikan lewat
          CSS, bukan type="hidden"), tapi bot yang mengisi semua input akan
          mengisinya — dan server membuang pesan itu tanpa suara.
        */}
        <div class="hp" aria-hidden="true">
          <label for="cf-situs">{c.fSitus}</label>
          <input id="cf-situs" type="text" name={HONEYPOT} tabindex="-1" autocomplete="off" />
        </div>

        <button type="submit" class="btn btn-p" id="cf-kirim" data-teks={c.fKirim}>{c.fKirim}</button>
        <script type="application/json" id="cf-teks" set:html={JSON.stringify({
          jaringan: c.errJaringan, terlaluSering: c.errTerlaluSering, gagal: c.errKirim,
        })} />
        <p class="note">{c.fNote}</p>
      </form>
    </div>
  </section>
</Base>

<style>
.order-steps{font-size:13px;line-height:1.7;color:var(--muted);margin:12px 0 24px}
.layout{display:grid;grid-template-columns:1fr 1.15fr;gap:48px;align-items:start}
@media(max-width:1000px){.layout{grid-template-columns:1fr;gap:36px}}
/* Disembunyikan dari manusia, tetap ada di DOM untuk bot. */
.hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
.info{display:grid;gap:14px}
.ibox{display:flex;gap:16px;padding:22px;border:1px solid var(--line);border-radius:var(--r);background:var(--card);transition:.25s var(--ease)}
.ibox:hover{border-color:var(--line-s)}
.ic{width:42px;height:42px;border-radius:7px;display:grid;place-items:center;flex:none;background:color-mix(in srgb,var(--pur) 13%,transparent);border:1px solid color-mix(in srgb,var(--pur) 26%,transparent);color:var(--brand)}
.ic svg{width:20px;height:20px}
.ibox h3{font-size:14px;margin-bottom:5px}
.ibox a{font-size:15px;font-weight:600;color:var(--brand)}
.ibox a:hover{opacity:.78}
.ibox p{font-size:13.5px;color:var(--txt-2);margin-top:3px}
address{font-style:normal;font-size:14.5px;color:var(--txt-2);line-height:1.65}
.maps{display:inline-block;margin-top:9px;font-size:13.5px !important}
.hrs{display:flex;justify-content:space-between;gap:14px;max-width:230px;margin-top:4px !important}
.hrs strong{color:var(--txt);font-weight:600}

.cf{display:grid;gap:15px;align-content:start;padding:32px;border:1px solid var(--line);border-radius:8px;background:var(--card);box-shadow:var(--shadow)}
@media(max-width:640px){.cf{padding:22px}}
.cf h2{font-size:21px;margin-bottom:4px}
.frow{display:grid;grid-template-columns:1fr 1fr;gap:15px}
@media(max-width:640px){.frow{grid-template-columns:1fr}}
.opt{font-weight:400;opacity:.7}
.cf button{margin-top:5px}
.cf .dd,.cf .dd-btn{width:100%}
.cf-top{margin-bottom:2px}
.note{font-size:12.5px;color:var(--txt-2);text-align:center;opacity:.8}
.ilus-kontak{margin-bottom:4px}
@media(max-width:1000px){.info{order:2}.info :global(.ilus-kontak){display:block;max-width:560px;margin:0 auto 12px}}
</style>

<script>
  import { pasangFormKontak } from '../../lib/form-kontak';
  const paket = document.querySelector<HTMLInputElement>('#k-paket');
  if (paket) {
    paket.value = (new URLSearchParams(location.search).get('paket') || '').slice(0, 120);
    paket.defaultValue = paket.value;
  }
  pasangFormKontak();
</script>
