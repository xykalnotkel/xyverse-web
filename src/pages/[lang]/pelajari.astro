---
import { jalurBahasa, rute } from '../../i18n/config';
import { pakaiT } from '../../i18n/ui';
import { PELAJARI } from '../../i18n/halaman/pelajari';

export function getStaticPaths() { return jalurBahasa(); }

const { lang } = Astro.props;
const t = pakaiT(lang);
const r = (p = '') => rute(lang, p);
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { SITE } from '../../data/site';

const c = PELAJARI[lang];
const jalur = c.jalur;
const istilah = c.istilah;

const ld = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: c.ldName,
  url: `${SITE.url}/pelajari`,
  description: c.ldDesc,
};
---

<Base
  lang={lang}
  title={`${c.metaTitle} — ${SITE.nama}`}
  desc={c.metaDesc}
  ogTag={c.ogTag}
  jsonld={ld}
>
  <PageHead
    eyebrow={c.eyebrow}
    title={c.judul}
    lead={c.lead}
  />

  <section class="sect" style="padding-top:40px">
    <div class="wrap">
      <div class="grid g2">
        {jalur.map((j: any) => (
          <article class="jcard reveal" style={`--c:${j.warna}`}>
            <div class="jhead">
              <span class="lvl">{j.lvl}</span>
              <span class="meta">{j.modul} {c.modul} · {j.durasi}</span>
            </div>
            <h2>{j.t}</h2>
            <p class="jd">{j.d}</p>
            <ol class="modul">
              {j.isi.map((m: string) => <li>{m}</li>)}
            </ol>
            <a href={r('kontak')} class="btn btn-g btn-sm">{c.mulai}</a>
          </article>
        ))}
      </div>

      <div class="kamus reveal">
        <h2 class="st">{c.kamusH2}</h2>
        <p class="sl">{c.kamusSl}</p>
        <div class="kgrid">
          {istilah.map((i: any) => (
            <div class="kit">
              <strong>{i.t}</strong>
              <small>{i.d}</small>
            </div>
          ))}
        </div>
      </div>

      <div class="cta reveal">
        <h2>{c.ctaH2}</h2>
        <p>{c.ctaP}</p>
        <div class="act">
          <a href={r('harga')} class="btn btn-p">{c.ctaB1}</a>
          <a href={r('panduan')} class="btn btn-g">{c.ctaB2}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
.jcard{
  border:1px solid var(--line);border-radius:12px;padding:24px;background:var(--card);
  box-shadow:var(--shadow);display:flex;flex-direction:column;
  transition:border-color .16s ease,box-shadow .16s ease;
}
.jcard:hover{border-color:color-mix(in srgb,var(--c) 45%,transparent);box-shadow:var(--shadow-h)}
.jhead{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px}
.lvl{
  font-size:11px;font-weight:700;padding:3px 9px;border-radius:5px;
  background:color-mix(in srgb,var(--c) 13%,transparent);
  border:1px solid color-mix(in srgb,var(--c) 32%,transparent);color:var(--c);
}
.meta{font-size:12.3px;color:var(--txt-2)}
.jcard h2{font-size:19px;margin-bottom:7px}
.jd{font-size:14.2px;color:var(--txt-2);margin-bottom:16px;line-height:1.65}
.modul{list-style:none;padding:0;counter-reset:m;margin-bottom:18px;flex:1}
.modul li{
  counter-increment:m;position:relative;padding:5px 0 5px 26px;
  font-size:13.6px;color:var(--txt-2);
}
.modul li::before{
  content:counter(m,decimal-leading-zero);position:absolute;left:0;top:5px;
  font-size:10.5px;font-weight:700;color:var(--c);opacity:.8;
}
.jcard .btn{align-self:flex-start}

.kamus{margin-top:40px}
.st{font-size:23px;margin-bottom:7px}
.sl{color:var(--txt-2);font-size:14.8px;margin-bottom:20px}
.kgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:11px}
.kit{border:1px solid var(--line);border-radius:8px;padding:15px 17px;background:var(--card);box-shadow:var(--shadow)}
.kit strong{display:block;font-size:14.5px;color:var(--brand);margin-bottom:4px}
.kit small{font-size:13.2px;color:var(--txt-2);line-height:1.6}

.cta{
  margin-top:40px;border:1px solid var(--line);border-radius:12px;padding:34px;
  background:var(--card);text-align:center;box-shadow:var(--shadow);
}
.cta h2{font-size:21px;margin-bottom:9px}
.cta p{color:var(--txt-2);font-size:15px;max-width:56ch;margin:0 auto 20px}
.cta .act{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
</style>
