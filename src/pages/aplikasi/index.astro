---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { SITE, APLIKASI } from '../../data/site';

const ld = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Aplikasi Xyverse',
  itemListElement: APLIKASI.map((a, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'SoftwareApplication',
      name: a.nama,
      description: a.desc,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: a.platform.join(', '),
      url: `${SITE.url}/aplikasi/${a.slug}`,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'IDR' },
      publisher: { '@type': 'Organization', name: SITE.nama },
    },
  })),
};
---

<Base
  title={`Aplikasi — ${SITE.nama}`}
  desc="XyDesk dan XyCloudStore: dua aplikasi resmi untuk mengakses dan mengelola Cloud PC Xyverse dari perangkat apa pun."
  ogTag="Aplikasi"
  jsonld={ld}
>
  <PageHead
    eyebrow="Aplikasi"
    title="Dua aplikasi untuk semua kebutuhan Cloud PC."
    lead="XyDesk menghubungkan lu ke mesin. XyCloudStore mengurus sisanya — langganan, instalasi, dan pemantauan. Keduanya gratis untuk pelanggan aktif."
  />

  <section class="sect">
    <div class="wrap">
      <div class="apps">
        {APLIKASI.map((a) => (
          <article class="app reveal" style={`--c:${a.warna}`}>
            <div class="atop">
              <span class="logo">{a.nama.slice(0, 2)}</span>
              <div>
                <h2>{a.nama}</h2>
                <p class="tag">{a.tagline}</p>
              </div>
              <span class="badge">{a.status}</span>
            </div>

            <p class="desc">{a.desc}</p>

            <ul class="plat">
              {a.platform.map((p) => <li>{p}</li>)}
            </ul>

            <ul class="fit">
              {a.fitur.slice(0, 4).map((f) => (
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  <span><strong>{f.t}</strong> — {f.d}</span>
                </li>
              ))}
            </ul>

            <div class="act">
              <a href={`/aplikasi/${a.slug}`} class="btn btn-p">Lihat detail</a>
              <a href="/harga" class="btn btn-g">Mulai berlangganan</a>
            </div>
          </article>
        ))}
      </div>

      <div class="cmp reveal">
        <h2>Bedanya apa?</h2>
        <div class="tbl">
          <table>
            <thead>
              <tr><th>Kebutuhan</th><th>XyDesk</th><th>XyCloudStore</th></tr>
            </thead>
            <tbody>
              <tr><td>Mengakses layar Cloud PC</td><td class="y">Ya</td><td class="n">—</td></tr>
              <tr><td>Menyalakan / mematikan mesin</td><td class="y">Ya</td><td class="y">Ya</td></tr>
              <tr><td>Memasang perangkat lunak</td><td class="n">—</td><td class="y">Ya</td></tr>
              <tr><td>Melihat tagihan & pemakaian</td><td class="n">—</td><td class="y">Ya</td></tr>
              <tr><td>Transfer berkas</td><td class="y">Ya</td><td class="n">—</td></tr>
              <tr><td>Kelola snapshot</td><td class="n">—</td><td class="y">Ya</td></tr>
              <tr><td>Undang anggota tim</td><td class="n">—</td><td class="y">Ya</td></tr>
              <tr><td>Berjalan di peramban</td><td class="n">—</td><td class="y">Ya</td></tr>
            </tbody>
          </table>
        </div>
        <p class="hint">Sebagian besar pelanggan memakai keduanya: XyCloudStore untuk mengatur, XyDesk untuk bekerja.</p>
      </div>
    </div>
  </section>
</Base>

<style>
.apps{display:grid;grid-template-columns:1fr 1fr;gap:22px}
@media(max-width:900px){.apps{grid-template-columns:1fr}}
.app{
  border:1px solid var(--line);border-radius:22px;padding:28px;background:var(--card);
  position:relative;overflow:hidden;transition:.3s var(--ease);
}
.app::before{content:'';position:absolute;inset:0 0 auto;height:3px;background:linear-gradient(90deg,transparent,var(--c),transparent);opacity:.8}
.app:hover{transform:translateY(-4px);border-color:color-mix(in srgb,var(--c) 40%,transparent)}
.atop{display:flex;align-items:center;gap:14px;margin-bottom:16px}
.logo{
  width:52px;height:52px;border-radius:15px;display:grid;place-items:center;flex-shrink:0;
  background:var(--c);color:#fff;font-weight:800;font-size:17px;letter-spacing:.5px;
}
.atop h2{font-size:22px;line-height:1.2}
.tag{font-size:13.5px;color:var(--txt-2);margin-top:2px}
.badge{
  margin-left:auto;align-self:flex-start;font-size:11px;font-weight:700;padding:4px 10px;border-radius:999px;
  background:color-mix(in srgb,#10b981 15%,transparent);color:#10b981;border:1px solid color-mix(in srgb,#10b981 30%,transparent);
}
.desc{color:var(--txt-2);font-size:14.8px;line-height:1.7;margin-bottom:16px}
.plat{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:18px;list-style:none;padding:0}
.plat li{font-size:11.5px;font-weight:600;padding:4px 10px;border-radius:7px;background:var(--surface);border:1px solid var(--line);color:var(--txt-2)}
.fit{list-style:none;padding:0;display:grid;gap:11px;margin-bottom:22px}
.fit li{display:flex;gap:10px;font-size:14px;color:var(--txt-2);line-height:1.6}
.fit strong{color:var(--txt)}
.fit svg{width:16px;height:16px;flex-shrink:0;margin-top:3px;color:var(--c)}
.act{display:flex;gap:10px;flex-wrap:wrap}

.cmp{margin-top:34px;border:1px solid var(--line);border-radius:22px;padding:30px;background:var(--card)}
.cmp h2{font-size:21px;margin-bottom:18px}
.tbl{overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:14.3px;min-width:460px}
th,td{padding:11px 14px;text-align:left;border-bottom:1px solid var(--line)}
th{font-size:12px;letter-spacing:.09em;text-transform:uppercase;color:var(--txt-2);font-weight:700}
th:not(:first-child),td:not(:first-child){text-align:center;width:22%}
td.y{color:#10b981;font-weight:600}
td.n{color:var(--txt-3, var(--txt-2));opacity:.5}
tbody tr:last-child td{border-bottom:0}
.hint{margin-top:16px;font-size:13.5px;color:var(--txt-2)}
</style>
