---
/**
 * Akar situs: mengalihkan ke bahasa yang paling cocok.
 * Urutan: pilihan tersimpan → bahasa peramban → bawaan (id).
 */
import { LANG_BAWAAN, SEMUA_LANG } from '../i18n/config';
import { SITE } from '../data/site';
---

<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Xyverse</title>
  <link rel="icon" href="/brand/mark-flat-purple.webp" />
  <meta name="robots" content="noindex" />
  {/* SITE.url, bukan hardcode — halaman akar ini satu-satunya yang
      menuliskan alamat situs sendiri di luar astro.config.mjs. */}
  <link rel="canonical" href={`${SITE.url}/${LANG_BAWAAN}/`} />
  {SEMUA_LANG.map((l) => (
    <link rel="alternate" hreflang={l} href={`${SITE.url}/${l}/`} />
  ))}
  <link rel="alternate" hreflang="x-default" href={`${SITE.url}/${LANG_BAWAAN}/`} />
  <meta http-equiv="refresh" content={`0; url=/${LANG_BAWAAN}/`} />
  <script is:inline define:vars={{ SEMUA_LANG, LANG_BAWAAN }}>
    (function () {
      var pilih = LANG_BAWAAN;
      try {
        var simpan = localStorage.getItem('xy-lang');
        if (simpan && SEMUA_LANG.indexOf(simpan) !== -1) {
          pilih = simpan;
        } else {
          var nav = (navigator.languages || [navigator.language || 'id']).map(function (x) {
            return String(x).toLowerCase().split('-')[0];
          });
          for (var i = 0; i < nav.length; i++) {
            if (SEMUA_LANG.indexOf(nav[i]) !== -1) { pilih = nav[i]; break; }
          }
        }
      } catch (e) {}
      location.replace('/' + pilih + '/' + location.search + location.hash);
    })();
  </script>
  <style>
    body{margin:0;height:100vh;display:grid;place-items:center;background:#0d0b14;color:#8b8698;
      font:15px/1.6 system-ui,-apple-system,Segoe UI,sans-serif}
  </style>
</head>
<body>
  <p>Mengalihkan… / Redirecting… <a href={`/${LANG_BAWAAN}/`} style="color:#a78bfa">Xyverse</a></p>
</body>
</html>
