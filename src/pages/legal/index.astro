---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { SITE } from '../../data/site';

const dok = [
  { h: '/legal/syarat-layanan', t: 'Syarat Layanan', d: 'Ketentuan penggunaan seluruh layanan Xyverse, hak dan kewajiban kedua pihak.', ik: 'doc' },
  { h: '/legal/kebijakan-privasi', t: 'Kebijakan Privasi', d: 'Data apa yang kami kumpulkan, bagaimana digunakan, dan hak lu atas data tersebut.', ik: 'shield' },
  { h: '/legal/kebijakan-cookie', t: 'Kebijakan Cookie', d: 'Jenis cookie yang dipakai situs ini dan cara mengendalikannya.', ik: 'cookie' },
  { h: '/legal/kebijakan-penggunaan', t: 'Kebijakan Penggunaan yang Wajar', d: 'Batasan pemakaian Cloud PC dan aktivitas yang dilarang.', ik: 'scale' },
  { h: '/legal/kebijakan-pengembalian', t: 'Kebijakan Pengembalian Dana', d: 'Ketentuan refund, pembatalan langganan, dan masa uji coba.', ik: 'coin' },
  { h: '/legal/sla', t: 'Jaminan Tingkat Layanan (SLA)', d: 'Komitmen uptime 99,9% dan skema kompensasi bila tidak terpenuhi.', ik: 'gauge' },
  { h: '/legal/lisensi', t: 'Lisensi', d: 'Lisensi perangkat lunak XyDesk, XyCloudStore, dan atribusi pihak ketiga.', ik: 'code' },
  { h: '/legal/dmca', t: 'DMCA & Hak Cipta', d: 'Prosedur pelaporan pelanggaran hak cipta dan sanggahan.', ik: 'flag' },
  { h: '/legal/keamanan', t: 'Kebijakan Keamanan', d: 'Praktik keamanan kami dan cara melaporkan kerentanan.', ik: 'lock' },
];

const IK: Record<string, string> = {
  doc: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h5"/>',
  shield: '<path d="M12 2.5 4.5 5.8v5.4c0 4.7 3.2 9 7.5 10.3 4.3-1.3 7.5-5.6 7.5-10.3V5.8z"/><path d="m9 12 2 2 4-4"/>',
  cookie: '<circle cx="12" cy="12" r="9.3"/><circle cx="9" cy="9.5" r="1.1" fill="currentColor" stroke="none"/><circle cx="14.5" cy="11" r="1.1" fill="currentColor" stroke="none"/><circle cx="10.5" cy="15" r="1.1" fill="currentColor" stroke="none"/>',
  scale: '<path d="M12 3v18M7 21h10M5 8h14M5 8 2.5 14h5zM19 8l2.5 6h-5z"/>',
  coin: '<circle cx="12" cy="12" r="9.3"/><path d="M14.5 9.2A3 3 0 0 0 12 8c-1.7 0-2.6.9-2.6 2s.9 1.8 2.6 2 2.6.9 2.6 2-.9 2-2.6 2a3 3 0 0 1-2.5-1.2M12 6.4v11.2"/>',
  gauge: '<path d="M4 17a9 9 0 1 1 16 0"/><path d="m12 13 4-3.5"/><circle cx="12" cy="17" r="1.6"/>',
  code: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
  flag: '<path d="M4 21V4M4 5h11l-1.6 3.4L15 12H4"/>',
  lock: '<rect x="4" y="10.5" width="16" height="11" rx="2.4"/><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"/>',
};

const ld = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Pusat Legal Xyverse',
  url: `${SITE.url}/legal`,
  hasPart: dok.map((d) => ({ '@type': 'WebPage', name: d.t, url: `${SITE.url}${d.h}` })),
};
---

<Base
  title={`Pusat Legal — ${SITE.nama}`}
  desc="Seluruh dokumen legal Xyverse: syarat layanan, kebijakan privasi, cookie, SLA, lisensi, DMCA, dan keamanan."
  ogTag="Legal"
  jsonld={ld}
>
  <PageHead
    eyebrow="Legal"
    title="Pusat dokumen legal."
    lead="Semua ketentuan ditulis dalam bahasa yang bisa dipahami, bukan kalimat berbelit. Setiap dokumen punya ringkasan di bagian atas."
  />

  <section class="sect" style="padding-top:44px">
    <div class="wrap">
      <div class="grid g3">
        {dok.map((d) => (
          <a href={d.h} class="card reveal dcard">
            <span class="ic">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={IK[d.ik]} />
            </span>
            <h2>{d.t}</h2>
            <p>{d.d}</p>
            <span class="go">Baca dokumen →</span>
          </a>
        ))}
      </div>

      <div class="note reveal">
        <h3>Butuh dokumen khusus?</h3>
        <p>
          Untuk kebutuhan enterprise kami dapat menyediakan Perjanjian Tingkat Layanan khusus,
          Perjanjian Pemrosesan Data (DPA), atau Perjanjian Kerahasiaan (NDA).
        </p>
        <a href={`mailto:${SITE.emailLegal}`} class="btn btn-p">Hubungi Tim Legal</a>
      </div>
    </div>
  </section>
</Base>

<style>
.dcard{display:flex;flex-direction:column}
.ic{
  width:44px;height:44px;border-radius:12px;display:grid;place-items:center;margin-bottom:16px;
  background:color-mix(in srgb,var(--pur) 13%,transparent);color:var(--brand);
  border:1px solid color-mix(in srgb,var(--pur) 26%,transparent);transition:.25s var(--ease);
}
.dcard:hover .ic{background:var(--pur);color:#fff}
.ic svg{width:21px;height:21px}
.dcard h2{font-size:18px;margin-bottom:8px;line-height:1.3}
.dcard p{color:var(--txt-2);font-size:14.3px;flex:1}
.go{margin-top:16px;font-size:13.5px;font-weight:600;color:var(--brand)}
.note{
  margin-top:26px;border:1px solid var(--line);border-radius:20px;padding:34px;
  background:var(--card);text-align:center;
}
.note h3{font-size:20px;margin-bottom:9px}
.note p{color:var(--txt-2);font-size:15px;max-width:60ch;margin:0 auto 20px}
</style>
