{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(id|en)/blog/.*",
      "dest": "/$1/blog/tidak-ada/index.html",
      "status": 404
    },
    {
      "src": "/(id|en)/berita/.*",
      "dest": "/$1/berita/tidak-ada/index.html",
      "status": 404
    },
    {
      "src": "/(id|en)/proyek/.*",
      "dest": "/$1/proyek/tidak-ada/index.html",
      "status": 404
    },
    {
      "src": "/(id|en)/legal/.*",
      "dest": "/$1/legal/tidak-ada/index.html",
      "status": 404
    },
    {
      "src": "/(id|en)/aplikasi/.*",
      "dest": "/$1/aplikasi/tidak-ada/index.html",
      "status": 404
    },
    {
      "src": "/(id|en)(?:/.*)?",
      "dest": "/$1/tidak-ada/index.html",
      "status": 404
    },
    {
      "src": "/.*",
      "dest": "/404.html",
      "status": 404
    }
  ]
}
